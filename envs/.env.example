# Environment
NODE_ENV=development
PORT=3000

# Monitoramento (Sentry) — DSN vazio = SDK inerte, não bloqueia boot em
# nenhum ambiente. Criar projeto Node/NestJS em sentry.io e colar o DSN aqui.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Database URLs
DATABASE_URL=postgresql://soundmeet:soundmeet123@localhost:5432/soundmeet
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://soundmeet:soundmeet123@localhost:5672
# Atenção: o exchange ativo no código é "soundmeet.events" (topic) e "direct.delayed".
# "soundmeet.exchange" abaixo é o valor histórico — não corresponde a nenhum exchange declarado.
RABBITMQ_EXCHANGE=soundmeet.exchange
# Queues reservadas para implementações futuras (Bloco 5 do roadmap)
RABBITMQ_QUEUE_REQUESTS=soundmeet.requests            # Futuro: Bloco 5.3 (outbox pattern)
RABBITMQ_QUEUE_NOTIFICATIONS=soundmeet.notifications  # Reservado: futura pipeline async/retry de notificações — push (Bloco 7.2) já vai direto via Expo Push API, não passa por aqui
RABBITMQ_QUEUE_PAYMENTS=soundmeet.payments            # Reservado

# Push notifications (Expo) — Bloco 7.2 do roadmap
# Opcional — expo-server-sdk funciona sem, mas com token aumenta rate limits
# e habilita o endpoint autenticado de receipts. Gerar em expo.dev (Access Tokens).
EXPO_ACCESS_TOKEN=

# Gamification — Bloco 5.2 (event-driven ranking via RabbitMQ)
# Queue que recebe payment.tip.completed do exchange soundmeet.events
RABBITMQ_QUEUE_GAMIFICATION=soundmeet.gamification
RABBITMQ_ROUTING_KEY_PAYMENT_TIP_COMPLETED=payment.tip.completed
# Transport: "inline" = sem consumer RabbitMQ (default); "rabbitmq" = ativa o consumer de ranking
GAMIFICATION_PROCESSING_TRANSPORT=inline

# Keycloak
# KEYCLOAK_ADMIN_PASSWORD / KEYCLOAK_DB_PASSWORD (senha do admin do Keycloak e
# do postgres-keycloak, SM-014) NÃO ficam aqui: este arquivo vira envs/.env,
# usado como env_file do container "app" — o docker-compose.yml lê essas duas
# via substituição de variável (${VAR}) do próprio Compose, que resolve a
# partir do .env na raiz do projeto (soundmeet-backend/.env). Ver .env.example
# na raiz.
AUTH_JWT_VALIDATION_MODE=local
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=soundmeet
KEYCLOAK_CLIENT_ID=soundmeet-api
KEYCLOAK_CLIENT_SECRET=your-client-secret
# Client público usado no Direct Access Grant pós-registro (POST /auth/register)
KEYCLOAK_MOBILE_CLIENT_ID=soundmeet-mobile
# Se a API rodar dentro do Docker, aponte para o hostname interno do container
# (ex.: http://keycloak:8080) — usado nas chamadas Admin API e Direct Access Grant
# do fluxo de registro. Deixe em branco quando a API roda direto no host (localhost
# já funciona nesse caso, pois a porta do Keycloak está publicada).
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_JWKS_URI=
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
# Valor esperado em `aud` — é o audience que o mapper `soundmeet-api-audience`
# injeta nos tokens dos clients públicos (scripts/keycloak-sync.mjs o cria com o
# valor fixo "soundmeet-api"). NÃO confunda com KEYCLOAK_CLIENT_ID, que é a
# credencial confidencial do backend e pode ter outro nome (ex.: soundmeet-backend).
# Vazio → cai em KEYCLOAK_CLIENT_ID.
KEYCLOAK_AUDIENCE=soundmeet-api
# Clients autorizados a emitir token para esta API (claim `azp`), separados por
# vírgula. Vazio desliga essa camada extra; a checagem de `aud` continua valendo.
KEYCLOAK_ALLOWED_AZP=
# Default: true em produção, false nos demais ambientes. Antes de ligar em um
# ambiente novo, rode com false e observe o log `auth.audience_check_disabled`
# (campo would_reject_if_enabled) para confirmar que os tokens reais já trazem
# o `aud` esperado.
KEYCLOAK_VERIFY_AUDIENCE=false

# Google OAuth (identity provider do Keycloak — login social)
# Tipo do app no Google Console: Web application
# Redirect URI autorizado: http://localhost:8080/realms/soundmeet/broker/google/endpoint
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_KEYCLOAK_CLIENT_ID=
GOOGLE_KEYCLOAK_CLIENT_SECRET=

# Google Calendar (sync de bookings — client OAuth SEPARADO do login social acima!
# O IdP do Keycloak tem storeToken:false e escopo só de login; NÃO reaproveitar.)
# Tipo do app no Google Console: Web application
# Escopo: https://www.googleapis.com/auth/calendar.events (+ openid email)
# O fluxo usa access_type=offline + prompt=consent para garantir refresh_token.
# Redirect URI autorizado (correspondência EXATA no Console):
#   http://localhost:3000/api/v1/google-calendar/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/google-calendar/oauth/callback
# noop (desligado, default) | rabbitmq (sync assíncrono em produção)
GOOGLE_CALENDAR_SYNC_TRANSPORT=noop
RABBITMQ_ROUTING_KEY_GOOGLE_CALENDAR_BOOKING_CONFIRMED=google-calendar.booking-confirmed.requested
RABBITMQ_ROUTING_KEY_GOOGLE_CALENDAR_BOOKING_CANCELLED=google-calendar.booking-cancelled.requested
RABBITMQ_QUEUE_GOOGLE_CALENDAR_BOOKING_CONFIRMED=soundmeet.google_calendar_booking_confirmed
RABBITMQ_QUEUE_GOOGLE_CALENDAR_BOOKING_CANCELLED=soundmeet.google_calendar_booking_cancelled
# Chave AES-256-GCM p/ tokens OAuth em repouso — gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=aOhH34UFJtDB96UIzY9sMwP3Y0QYWu9m0xDJ1kjn42o=

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=soundmeet-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.com

# MinIO (Development)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=soundmeet
MINIO_SECRET_KEY=soundmeet123
MINIO_BUCKET=soundmeet-media

# External APIs
CIFRA_CLUB_API_KEY=your-cifra-club-api-key
ULTIMATE_GUITAR_API_KEY=your-ultimate-guitar-api-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
GENIUS_CLIENT_ID=your-genius-client-id
GENIUS_CLIENT_SECRET=your-genius-client-secret
GENIUS_ACCESS_TOKEN=your-genius-access-token

# Asaas (cachê de show + escrow + assinaturas recorrentes de plano + saque PIX)
# Sandbox: https://sandbox.asaas.com/api/v3 | Produção: https://api.asaas.com/v3
# Reutilizadas pelo checkout de assinatura (plans-module) — mesma conta/chave do saque PIX.
# Sem ASAAS_API_KEY, o plans-module usa FakeSubscriptionBillingGateway (dev/testes).
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WALLET_ID=your-asaas-wallet-id
ASAAS_WEBHOOK_TOKEN=your-asaas-webhook-token

# Iugu (gorjetas PIX — 0,99% sem mínimo fixo)
# Sandbox: https://sandbox.iugu.com | Produção: https://api.iugu.com
IUGU_API_URL=https://api.iugu.com/v1
IUGU_API_TOKEN=your-iugu-api-token
IUGU_ACCOUNT_ID=your-iugu-account-id
IUGU_WEBHOOK_TOKEN=your-iugu-webhook-token

# Push Notifications: enviadas via expo-server-sdk (Expo Push), sem credencial
# de servidor aqui — o token do device vem do app. Firebase Admin foi removido.

# Send Email - Resend (transacional)
# Chave da API Resend (https://resend.com/api-keys) — começa com re_...
# IMPORTANTE: Esta mesma chave é usada como senha SMTP pelo Keycloak (${env.RESEND_API_KEY} no realm)
RESEND_API_KEY=your-resend-api-key
# Endereço remetente — deve estar verificado no Resend (domínio soundmeet.com.br)
MAIL_FROM=noreply@soundmeet.com.br
# URL base para geração de links de verificação de email
MAIL_BASE_URL=https://api.soundmeet.com.br

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg

# Establishment Storage (cardápio PDF e futuros assets do estabelecimento)
# Providers: cloudflare_r2 | minio | aws_s3
ESTABLISHMENT_STORAGE_PROVIDER=cloudflare_r2
ESTABLISHMENT_MENU_PDF_MAX_SIZE=5242880
# URL pública do bucket R2 (domínio personalizado ou sub-domínio pub-*.r2.dev)
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Cloudflare R2 (S3-compatible — usado por ai-cifra e establishment)
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=soundmeet-media

# AI Cifra (análise de cifras sem separação)
AI_CIFRA_STORAGE_PROVIDER=minio
AI_CIFRA_MAX_FILE_SIZE=73400320
AI_CIFRA_ALLOWED_MIME_TYPES=audio/mpeg,audio/wav,audio/flac,audio/ogg
AI_CIFRA_DEFAULT_MODEL_ID=chordformer_v22_phase2
AI_CIFRA_ANALYSIS_HTTP_BASE_URL=http://ai-cifra-worker:8000
AI_CIFRA_ANALYSIS_HTTP_PATH=/v2/analyze
AI_CIFRA_ANALYSIS_HTTP_TIMEOUT_MS=1800000
AI_CIFRA_PROCESSING_TRANSPORT=http
AI_CIFRA_PROCESSING_CONCURRENCY=1
AI_CIFRA_PROGRESS_TOKEN=change-me

# Cifra pessoal — kill-switch da comunidade.
# "false" derruba /community/personal-chord-sheets (404) sem precisar de deploy.
# As rotas do dono seguem intactas: ninguém perde a própria cifra.
# Existe porque publicar cifra COM LETRA é risco de licenciamento assumido
# conscientemente — LRCLIB não é licença de exibição (Docs/AI-musician/chord-sheet.md).
PERSONAL_CHORD_SHEET_COMMUNITY_ENABLED=true

# AI Audio (separação em stems)
AI_AUDIO_STORAGE_PROVIDER=minio
AI_AUDIO_SEPARATION_HTTP_BASE_URL=http://ai-audio-separation:8000
AI_AUDIO_SEPARATION_HTTP_PATH=/v1/separate
AI_AUDIO_SEPARATION_HTTP_TIMEOUT_MS=1800000
AI_AUDIO_PROCESSING_TRANSPORT=http
AI_AUDIO_PROCESSING_CONCURRENCY=1
AI_AUDIO_MAX_FILE_SIZE=73400320
AI_AUDIO_ALLOWED_MIME_TYPES=audio/mpeg,audio/wav,audio/flac,audio/ogg
AI_AUDIO_DEFAULT_MODEL_ID=htdemucs_4stems
AI_AUDIO_PROGRESS_TOKEN=change-me

# RabbitMQ (AI Cifra)
RABBITMQ_ROUTING_KEY_AI_CIFRA_ANALYSIS_REQUESTED=ai-musician.cifra-analysis.requested
RABBITMQ_ROUTING_KEY_AI_CIFRA_ANALYSIS_COMPLETED=ai-musician.cifra-analysis.completed
RABBITMQ_ROUTING_KEY_AI_CIFRA_ANALYSIS_FAILED=ai-musician.cifra-analysis.failed
RABBITMQ_QUEUE_AI_CIFRA_ANALYSIS=soundmeet.ai_cifra_analysis
RABBITMQ_QUEUE_AI_CIFRA_ANALYSIS_COMPLETED=soundmeet.ai_cifra_analysis.completed
RABBITMQ_QUEUE_AI_CIFRA_ANALYSIS_FAILED=soundmeet.ai_cifra_analysis.failed

# Gamification
POINTS_SCAN_QR=10
POINTS_MUSIC_REQUEST=25
POINTS_REQUEST_ACCEPTED=50
POINTS_TIP_MULTIPLIER=1
POINTS_SOCIAL_SHARE=50

# Anti-Spam
MAX_REQUESTS_PER_USER_PER_EVENT=5
REQUEST_COOLDOWN_MINUTES=2
VOTING_INTERVAL_MINUTES=3
