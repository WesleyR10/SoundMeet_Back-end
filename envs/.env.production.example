# ─────────────────────────────────────────────────────────────────────────────
# SoundMeet — variáveis de PRODUÇÃO (modelo)
#
# Copie para `envs/.env.production` e preencha. O arquivo real NUNCA vai para o
# git — é o que `docker-compose.prod.yml` carrega no serviço `app`.
#
# As credenciais de infraestrutura (POSTGRES_*, REDIS_PASSWORD, RABBITMQ_*,
# KEYCLOAK_ADMIN*) NÃO ficam aqui: o compose as lê do ambiente do shell ou de um
# `.env` na raiz, e recusa subir se faltarem. Mantê-las fora deste arquivo
# significa que um vazamento dele não entrega o banco junto.
#
# ⚠️ TODA variável abaixo sem valor é OBRIGATÓRIA em produção — o Joi recusa o
# boot se faltar, e o container entra em restart loop. A lista foi levantada
# rodando `scripts/smoke-test-prod.sh`: a primeira versão deste arquivo omitia
# metade delas, e o defeito só apareceria no deploy.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# 🔴 Base pública do QR CODE IMPRESSO — o host do `soundmeet-web`, NÃO o da API.
#
# `APP_URL` alimenta `buildMusicianQrLink` (musician.aggregate.ts) e a allowlist
# de origem do `ScanQRUseCase`. Este arquivo trazia `https://api.soundmeet.com.br`
# até 07/set/2026: o QR sairia apontando para o Nest, onde `/musico/<uuid>`
# responde 404 — o prefixo global é `api/v1`. Adesivo impresso não se corrige.
#
# Apex sem `www`: redirect quebra Universal Link no iOS e a busca de
# `assetlinks.json` no Android — o SO não segue 3xx em nenhuma das duas.
APP_URL=https://soundmeet.com.br

# ── SM-020 — superfície HTTP ─────────────────────────────────────────────────

# Origens autorizadas no CORS, separadas por vírgula. OBRIGATÓRIA em produção
# (o Joi recusa o boot sem ela) e sem default de propósito: a lista antiga
# embutia `http://localhost:3000` em todos os ambientes, o que anulava a
# proteção justamente onde ela importava.
CORS_ALLOWED_ORIGINS=https://app.soundmeet.com.br,https://soundmeet.com.br

# Documentação da API. `false` é o padrão em produção — `/api/docs` responde
# 404. Ligar publica o contrato completo da API e ativa `persistAuthorization`,
# que guarda o token no navegador de quem abrir a página.
SWAGGER_ENABLED=false

# ── Autenticação ─────────────────────────────────────────────────────────────

AUTH_JWT_VALIDATION_MODE=keycloak
KEYCLOAK_URL=https://auth.soundmeet.com.br
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=soundmeet
KEYCLOAK_CLIENT_ID=soundmeet-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/soundmeet/protocol/openid-connect/certs
# Audience do oidc-audience-mapper, NÃO o client confidencial do backend.
KEYCLOAK_AUDIENCE=soundmeet-api
KEYCLOAK_VERIFY_AUDIENCE=true

JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Pagamentos ───────────────────────────────────────────────────────────────

ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
# Carteira da plataforma no Asaas (formato GUID) — destino da comissão no split.
ASAAS_WALLET_ID=
# Fail-closed: o webhook rejeita tudo sem este token.
ASAAS_WEBHOOK_TOKEN=
MERCADOPAGO_API_URL=https://api.mercadopago.com
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://api.soundmeet.com.br/api/v1/musicians/mercadopago/callback
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_FEE_PERCENTAGE=0.99
MERCADOPAGO_APP_RETURN_URL=soundmeet://carteira/mercadopago
# Não usados pelo backend hoje. Se preencher, são as credenciais de PRODUÇÃO da
# SoundMeetPIX — nunca as de teste, nunca as da app leftover SoundMeet.
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Custódia do cachê. Sem o nome da instituição de pagamento o escrow não liga —
# e o nome é o DELA, nunca "SoundMeet".
ESCROW_ENABLED=false
ESCROW_CUSTODIAN_LEGAL_NAME=

# ── Storage ──────────────────────────────────────────────────────────────────

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=
# Bucket PRIVADO e separado: o contrato tem CPF, CNPJ, endereço e cachê.
CONTRACT_STORAGE_PROVIDER=aws_s3
CONTRACT_STORAGE_BUCKET=

# Chave de cifra em repouso (SM-016) — protege chave PIX, conta bancária e os
# tokens OAuth que movem dinheiro na conta do músico.
# ── E-mail transacional ──────────────────────────────────────────────────────
#
# 🔴 Obrigatória em produção: o `MailService` instancia o SDK do Resend no
# construtor e ele LANÇA sem chave — o app não sobe.
RESEND_API_KEY=
MAIL_FROM=noreply@soundmeet.com.br

# ── Tokens de serviço ────────────────────────────────────────────────────────
#
# Autenticam os workers de IA chamando de volta a API. Obrigatórios em produção:
# sem eles, as rotas de progresso ficariam abertas a quem descobrisse a URL.
AI_AUDIO_PROGRESS_TOKEN=
AI_CIFRA_PROGRESS_TOKEN=
SYNCED_LYRICS_BULK_TOKEN=
# A-10: shared secret backend → workers de IA (header x-ai-worker-token). OBRIGATÓRIO.
# O MESMO valor precisa estar setado nos containers ai-cifra-worker(-gpu) e
# ai-audio-separation (host de GPU); sem ele, os workers recusam processamento (503).
AI_WORKER_TOKEN=

# ── Google Calendar ──────────────────────────────────────────────────────────

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# URI absoluta — o Joi valida o formato.
GOOGLE_CALENDAR_REDIRECT_URI=https://api.soundmeet.com.br/api/v1/google-calendar/callback

# Assina o desafio de assinatura do contrato. Mínimo de 32 caracteres:
#   openssl rand -hex 32
CONTRACT_CHALLENGE_SECRET=

# Base64 de 32 bytes:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# AUTH-1 — client CONFIDENCIAL do auto-login pós-cadastro (Direct Access Grant).
# O `soundmeet-mobile` deixou de aceitar grant de senha: o client_id dele viaja
# dentro do APK, então qualquer script batia direto no /token do Keycloak,
# pulando o @Throttle do Nest. Com secret, o grant só existe dentro do backend.
# Precisa casar com KEYCLOAK_REGISTRATION_CLIENT_SECRET do keycloak-sync.mjs.
KEYCLOAK_REGISTRATION_CLIENT_ID=soundmeet-registration
KEYCLOAK_REGISTRATION_CLIENT_SECRET=defina-no-secret-manager
