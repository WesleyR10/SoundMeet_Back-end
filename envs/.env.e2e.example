NODE_ENV=test
PORT=3001

# Database URLs
DATABASE_URL=postgresql://soundmeet:soundmeet123@localhost:5432/soundmeet
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://soundmeet:soundmeet123@localhost:5672
RABBITMQ_EXCHANGE=soundmeet.exchange
RABBITMQ_QUEUE_REQUESTS=soundmeet.requests
RABBITMQ_QUEUE_NOTIFICATIONS=soundmeet.notifications
RABBITMQ_QUEUE_PAYMENTS=soundmeet.payments
RABBITMQ_QUEUE_GAMIFICATION=soundmeet.gamification

# Keycloak
# E2E roda no host (não em container): KEYCLOAK_INTERNAL_URL=localhost.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=soundmeet
KEYCLOAK_CLIENT_ID=soundmeet-api
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_MOBILE_CLIENT_ID=soundmeet-mobile

# Send Email - Resend (nunca commitar chave real; use só em envs/.env.e2e local)
RESEND_API_KEY=your-resend-api-key

# JWT
JWT_SECRET=test-jwt-secret-key-for-e2e-tests
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-e2e-tests
JWT_REFRESH_EXPIRES_IN=7d

# AWS / MinIO
AWS_REGION=us-east-1
AWS_S3_BUCKET=soundmeet-test-bucket
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_ACCESS_KEY=soundmeet
MINIO_SECRET_KEY=soundmeet123
MINIO_BUCKET=soundmeet-media
MINIO_DOCKER_ENDPOINT=host.docker.internal

# AI Cifra
AI_CIFRA_STORAGE_PROVIDER=minio
AI_CIFRA_MAX_FILE_SIZE=73400320
AI_CIFRA_ALLOWED_MIME_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/flac,audio/x-flac,audio/mp4,audio/x-m4a
AI_CIFRA_DEFAULT_MODEL_ID=chordformer_v22_phase2
AI_CIFRA_PROCESSING_TRANSPORT=http
AI_CIFRA_ANALYSIS_HTTP_BASE_URL=http://localhost:8002
AI_CIFRA_ANALYSIS_HTTP_PATH=/v2/analyze
AI_CIFRA_ANALYSIS_HTTP_TIMEOUT_MS=3600000

# AI Audio
AI_AUDIO_STORAGE_PROVIDER=minio
AI_AUDIO_MAX_FILE_SIZE=209715200
AI_AUDIO_ALLOWED_MIME_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/flac,audio/x-flac,audio/mp4,audio/x-m4a
AI_AUDIO_DEFAULT_MODEL_ID=htdemucs_4stems
AI_AUDIO_PROCESSING_TRANSPORT=http
AI_AUDIO_SEPARATION_HTTP_BASE_URL=http://localhost:8000
AI_AUDIO_SEPARATION_HTTP_PATH=/v1/separate
AI_AUDIO_SEPARATION_HTTP_TIMEOUT_MS=3600000

SEPARATION_FAKE=false
SEPARATION_TRIM_SECONDS=0

# AI_AUDIO_E2E_FILE=/absolute/path/to/sample.mp3
AI_AUDIO_E2E_MODEL_IDS=htdemucs_4stems

MODEL_HTDEMUCS_4_CHECKPOINT=/models/htdemucs_4stems.ckpt
MODEL_HTDEMUCS_6_CHECKPOINT=/models/htdemucs_6stems.ckpt
MODEL_MDX23C_CHECKPOINT=/models/mdx23c.ckpt
MODEL_BS_ROFORMER_CHECKPOINT=/models/bs_roformer.ckpt
MODEL_MEL_BAND_ROFORMER_CHECKPOINT=/models/mel_band_roformer.ckpt

# Rate Limiting / Upload / Gamification / Business (defaults de teste)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/mp4
POINTS_SCAN_QR=10
POINTS_MUSIC_REQUEST=25
POINTS_REQUEST_ACCEPTED=50
POINTS_TIP_MULTIPLIER=1
POINTS_SOCIAL_SHARE=50
MAX_REQUESTS_PER_USER_PER_EVENT=5
REQUEST_COOLDOWN_MINUTES=2
VOTING_INTERVAL_MINUTES=3
