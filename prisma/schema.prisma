// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =================== =====================
// ENUMS COMPARTILHADOS
// ========================================

enum CurrencyEnum {
  BRL
  USD
  EUR
}

// Enums de máquina de estado de domínio (valores idênticos aos VOs/uniões do domínio).
// Status operacionais de worker (ai-audio, ai-cifra, synced-lyrics) permanecem String
// por serem telemetria evolutiva, não máquinas de estado de domínio.
enum EventStatus {
  scheduled
  active
  completed
  cancelled
}

enum EventMusicianStatus {
  confirmed
  pending
  cancelled
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  expired
}

enum InquiryStatus {
  open
  accepted
  rejected
  converted
  expired
}

/// Máquina de estado do contrato digital (F1.3b).
/// `annulled` e não `void` porque `void` é palavra reservada em TypeScript.
/// Não há `draft`: a emissão é automática no BookingConfirmedEvent e nasce
/// completa — estado sem produtor vira coluna morta.
enum ContractStatus {
  issued
  partially_signed
  signed
  annulled
}

enum TipStatus {
  pending
  completed
  failed
  refunded
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

/// Estado da custódia do cachê. Máquina de estados de DOMÍNIO, por isso enum e
/// não String — a regra do projeto reserva String para status operacional de
/// worker, que é telemetria evolutiva. Aqui cada transição tem consequência
/// financeira e precisa que o banco recuse o valor inválido.
enum BookingEscrowStatus {
  pending
  held
  released
  refunded
  disputed
}

enum MusicRequestStatus {
  pending
  accepted
  rejected
  played
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

// =================== =====================
// DOMÍNIO MUSICIAN
// ========================================

model Musician {
  id                     String    @id @default(uuid())
  email                  String    @unique
  name                   String
  stage_name             String?
  bio                    String?
  avatar                 String?
  phone                  String?   @unique
  cpf                    String?   @unique
  // CNPJ do MEI. Opcional e fora do cadastro: entra em configurações do perfil.
  cnpj                   String?   @unique
  genres                 String[]  @default([])
  instruments            String[]  @default([])
  experience_years       Int?
  qr_code                String?   @unique
  qr_foreground_color    String?
  qr_background_color    String?
  qr_logo_url            String?
  qr_label               String?
  push_token             String?
  push_token_platform    String?
  rating                 Float     @default(0)
  total_ratings          Int       @default(0)
  is_active              Boolean   @default(true)
  is_verified            Boolean   @default(false)
  // Consentimento explícito para aparecer em busca de estabelecimentos
  // (radar de contratação). null = ainda não decidiu — nunca default true,
  // decisão forçada no onboarding. Só true aparece em qualquer busca pública.
  open_to_gigs           Boolean?
  email_verified_at      DateTime?
  email_pending          String?
  // Legado (SM-016, texto puro, reversível) — substituído por
  // email_token_hash (SHA-256, one-way). Mantido só para o backfill;
  // remoção em migration futura (política: adicionar → backfill → remover).
  email_token            String?
  // SHA-256 do token enviado por e-mail — nunca decifrado, só comparado no
  // momento da verificação (mesma ideia de um token de reset de senha).
  email_token_hash       String?
  email_token_expires_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Relacionamentos
  profile                     MusicianProfile?
  bands                       BandMember[]
  requests                    MusicRequest[]
  tips                        Tip[]
  events                      EventMusician[]
  analytics                   MusicianAnalytics[]
  library                     MusicLibrary[]
  interactions                UserInteraction[]
  bookings                    Booking[]
  inquiries                   Inquiry[]
  calendar_settings           MusicianCalendarSettings?
  availability_rules          MusicianAvailabilityRule[]
  unavailabilities            MusicianUnavailability[]
  ai_audio_uploads            AiAudioUpload[]
  ai_audio_separation_jobs    AiAudioSeparationJob[]
  ai_cifra_uploads            AiCifraUpload[]
  ai_cifra_analysis_jobs      AiCifraAnalysisJob[]
  synced_lyrics_bulk_jobs     SyncedLyricsBulkJob[]
  wallet                      MusicianWallet?
  transactions                Transaction[]
  subscriptions               Subscription[]
  repertoires                 Repertoire[]
  google_calendar_integration GoogleCalendarIntegration?
  personal_chord_sheets       PersonalChordSheet[]
  contracts                   Contract[]
  booking_escrows             BookingEscrow[]
  performances                Performance[]

  @@map("musicians")
}

model MusicianProfile {
  id                 String        @id @default(uuid())
  musicianId         String        @unique
  // Legado (modelo único) — backfillado para os pares abaixo; remoção em
  // migration futura (política: adicionar → backfill → remover em separado)
  price_model        String? // "per_event" | "per_hour"
  price_min          Decimal?      @db.Decimal(12, 2)
  price_max          Decimal?      @db.Decimal(12, 2)
  price_currency     CurrencyEnum? @default(BRL)
  price_notes        String?
  // Uma faixa por modelo de cobrança — o músico pode precificar por hora E
  // por evento simultaneamente, com min/max/notas independentes
  price_hour_min     Decimal?      @db.Decimal(12, 2)
  price_hour_max     Decimal?      @db.Decimal(12, 2)
  price_hour_notes   String?
  price_event_min    Decimal?      @db.Decimal(12, 2)
  price_event_max    Decimal?      @db.Decimal(12, 2)
  price_event_notes  String?
  location           Json // {city: "São Paulo", state: "SP", coordinates: {lat: -23.5505, lng: -46.6333}}
  // Denormalizado do JSON `location` (latitude/longitude) pelo mapper a cada
  // save — pré-filtro indexável da busca por raio (7.13c), mesmo padrão de
  // EstablishmentProfile.location_lat/lng. Fonte de verdade segue o JSON.
  location_lat       Float?
  location_lng       Float?
  // Modo turnê (7.13d) — segundo ponto de busca, opcional e com expiração
  // automática, somado à base permanente (nunca a substitui). Mesmo padrão
  // de denormalização de location/location_lat/lng acima.
  touring_location   Json?
  touring_lat        Float?
  touring_lng        Float?
  touring_expires_at DateTime?
  socialLinks        Json? // {instagram: "@musician", youtube: "channel"}
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([location_lat, location_lng])
  @@index([touring_lat, touring_lng])
  @@map("musician_profiles")
}

model Band {
  id             String        @id @default(uuid())
  name           String
  description    String?
  avatar         String?
  genres         String[]
  qr_code        String?       @unique
  price_model    String? // "per_event" | "per_hour"
  price_min      Decimal?      @db.Decimal(12, 2)
  price_max      Decimal?      @db.Decimal(12, 2)
  price_currency CurrencyEnum? @default(BRL)
  price_notes    String?
  is_active      Boolean       @default(true)
  // Consentimento explícito do líder para a banda aparecer em busca de
  // estabelecimentos — independente do open_to_gigs individual de cada
  // membro. null = ainda não decidiu, nunca default true.
  open_to_gigs   Boolean?
  // Endereço próprio da banda (não herdado do líder), mesmo formato JSON de
  // MusicianProfile.location. Denormalizado em location_lat/lng para busca
  // por raio, mesmo padrão de MusicianProfile/EstablishmentProfile.
  address        Json?
  location_lat   Float?
  location_lng   Float?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  members            BandMember[]
  events             EventMusician[]
  tips               Tip[]
  bookings           Booking[]
  inquiries          Inquiry[]
  calendar_settings  BandCalendarSettings?
  availability_rules BandAvailabilityRule[]
  unavailabilities   BandUnavailability[]
  transactions       Transaction[]
  contracts          Contract[]
  performances       Performance[]

  @@index([location_lat, location_lng])
  @@map("bands")
}

model BandAvailabilityRule {
  id           String   @id @default(uuid())
  bandId       String
  weekday      Int
  start_time   String
  end_time     String
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId, weekday])
  @@map("band_availability_rules")
}

model BandMember {
  id           String           @id @default(uuid())
  bandId       String
  musicianId   String
  // Papel de decisão, não rótulo livre: só o líder aceita/recusa convite de
  // evento e confirma/cancela booking em nome da banda.
  role         BandMemberRole
  instrument   String
  joinedAt     DateTime         @default(now())
  // Fluxo de convite/aceite. Default `accepted` só serve para backfill de
  // linhas existentes (membros já adicionados antes deste fluxo existir);
  // membros novos sempre nascem `pending` via Band.inviteMember().
  status       BandMemberStatus @default(accepted)
  responded_at DateTime?

  band     Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  // ⚠️ Existe também o índice parcial ÚNICO `band_members_one_accepted_leader`
  // — `(bandId) WHERE role = 'leader' AND status = 'accepted'` — criado em
  // 20260729103000_band_member_role_enum_and_single_leader. Prisma não sabe
  // expressar índice parcial, então ele vive só no SQL: se algum `migrate dev`
  // gerar um DROP INDEX dele, **remova esse DROP** e mantenha o índice. É ele
  // que impede dois líderes em corrida entre duas requisições simultâneas.

  @@unique([bandId, musicianId])
  @@index([bandId, role])
  @@map("band_members")
}

// Fechado de propósito: era String livre e aceitava "Leader"/"vocalista", o
// que fazia o líder perder as próprias decisões sem erro visível.
enum BandMemberRole {
  leader
  member
}

enum BandMemberStatus {
  pending
  accepted
  declined
}

model MusicLibrary {
  id                             String    @id @default(uuid())
  musicianId                     String
  title                          String
  artist                         String
  genre                          String?
  key                            String? // Tom da música
  bpm                            Int?
  lyrics                         String?
  chords                         Json? // Cifras customizadas
  structure_segments             Json? // Segmentação estrutural (ex.: intro/verse/chorus)
  chord_sheet                    Json?
  chord_sheet_version            Int       @default(0)
  renderable_chord_sheet         Json?
  renderable_chord_sheet_version Int       @default(0)
  notes                          String? // Anotações pessoais
  difficulty                     Int       @default(1) // 1-5
  isFavorite                     Boolean   @default(false)
  source                         String? // "cifra_club", "ultimate_guitar", "custom"
  sourceId                       String? // ID da fonte externa
  // [SyncedLyrics] — campos abaixo são gerenciados exclusivamente por SyncedLyricsModelMapper.
  // NÃO escrever via MusicLibraryModelMapper. Aggregate: SyncedLyrics em src/core/synced-lyrics/.
  lrc_raw                        String?
  lrc_normalized                 Json?
  lrc_provider                   String?
  lrc_provider_meta              Json?
  lrc_hash                       String?
  lrc_version                    Int       @default(1)
  lrc_pipeline_version           Int       @default(1)
  lrc_quality_flags              String[]  @default([])
  lrc_coverage_ms                Int?
  lrc_has_word_timestamps        Boolean   @default(false)
  lrc_last_synced_at             DateTime?
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  duration_seconds Int?

  /// [Spotify] Faixa correspondente no catálogo do Spotify, resolvida a partir
  /// de título + artista + DURAÇÃO da gravação que o músico analisou. A duração
  /// é o que separa estúdio de ao vivo, remaster e remix — mesmo sinal e mesma
  /// fórmula que `synced-lyrics` usa para escolher a LRC certa.
  ///
  /// Ver `Docs/AI-musician/spotify-track-matching.md`.
  spotifyTrackId    String?
  /// 0..1 — quanto o candidato casou. Guardado porque o custo de errar é
  /// diferente por caminho: abrir no Spotify tolera score médio (o fã vê e
  /// julga); escrever na biblioteca dele, não.
  spotifyMatchScore Float?
  /// Quando procuramos pela última vez. Preenchido COM `spotifyTrackId` nulo
  /// significa "procuramos e não achamos" — negative cache, mesma política do
  /// LRCLIB. Sem isso, música fora do catálogo seria reconsultada para sempre.
  spotifyCheckedAt  DateTime?

  musician              Musician             @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  requests              MusicRequest[]
  ai_cifra_uploads      AiCifraUpload[]
  ai_audio_uploads      AiAudioUpload[]
  repertoire_songs      RepertoireSong[]
  personal_chord_sheets PersonalChordSheet[]
  performed_songs       PerformedSong[]

  @@index([artist, title])
  @@index([lrc_hash])
  /// O job de backfill varre por "nunca procurado" — sem índice parcial isso
  /// seria sequential scan recorrente na tabela que mais cresce.
  @@index([spotifyCheckedAt])
  @@map("music_library")
}

// ========================================
// DOMÍNIO ESTABLISHMENT - BAR, RESTAURANT, CLUB, VENUE
// ========================================

model Establishment {
  id                            String  @id @default(uuid())
  email                         String  @unique
  name                          String
  description                   String?
  avatar                        String?
  cnpj                          String? @unique
  // Quem assina pela PJ. Coletado em configurações do perfil, não no cadastro.
  legal_representative_name     String?
  legal_representative_document String?
  phone                         String?
  website                       String?

  establishment_type String
  qr_code            String? @unique
  rating             Float   @default(0)
  total_ratings      Int     @default(0)

  is_active              Boolean   @default(true)
  is_verified            Boolean   @default(false)
  email_verified_at      DateTime?
  email_pending          String?
  // Legado (SM-016) — ver comentário equivalente em Musician.email_token.
  email_token            String?
  email_token_hash       String?
  email_token_expires_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Relacionamentos
  profile       EstablishmentProfile?
  events        Event[]
  bookings      Booking[]
  inquiries     Inquiry[]
  analytics     EstablishmentAnalytics[]
  rankings      Ranking[]
  subscriptions Subscription[]
  campaigns     Campaign[]
  contracts     Contract[]
  performances  Performance[]

  @@map("establishments")
}

model EstablishmentProfile {
  id              String   @id @default(uuid())
  establishmentId String   @unique
  capacity        Int?
  location        Json
  location_city   String
  location_lat    Float?
  location_lng    Float?
  amenities       String[] @default([]) // ["sound_system", "stage", "parking"]
  preferredGenres String[] @default([])
  operatingHours  Json?
  stageTechSpec   Json? // Ficha técnica do palco (A3) — StageTechSpec VO
  priceRange      Json?
  socialLinks     Json?
  menu_pdfs       Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([location_city])
  @@index([location_lat, location_lng])
  @@index([capacity])
  @@index([amenities], type: Gin)
  @@index([preferredGenres], type: Gin)
  @@map("establishment_profiles")
}

model Event {
  id              String      @id @default(uuid())
  establishmentId String
  name            String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          EventStatus @default(scheduled)
  maxCapacity     Int?
  currentCapacity Int         @default(0)
  isPublic        Boolean     @default(true)
  coverCharge     Float?      @default(0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  musicians     EventMusician[]
  requests      MusicRequest[]
  attendees     EventAttendee[]
  bookings      Booking[]
  inquiries     Inquiry[]
  tips          Tip[]
  performances  Performance[]

  /// Bloco 9.4b — o job de auto-finalização roda a cada 10 min filtrando
  /// status + endTime. Sem este índice seria sequential scan recorrente.
  @@index([status, endTime])
  /// Bloco 9.4a/9.4d — listagem por estabelecimento (aninhada e atalho
  /// `events/active`), sempre com visibilidade e ordenação por data.
  @@index([establishmentId, status, startTime])
  @@map("events")
}

model EventMusician {
  id         String              @id @default(uuid())
  eventId    String
  musicianId String?
  bandId     String?
  fee        Decimal?            @db.Decimal(12, 2)
  status     EventMusicianStatus @default(confirmed)
  startTime  DateTime?
  endTime    DateTime?
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)

  @@map("event_musicians")
}

model Booking {
  id                      String        @id @default(uuid())
  establishmentId         String
  eventId                 String?
  musicianId              String?
  bandId                  String?
  start_at                DateTime
  end_at                  DateTime
  fee                     Decimal?      @db.Decimal(12, 2) // Custo da reserva
  status                  BookingStatus @default(pending)
  notes                   String? // Notas adicionais sobre a reserva
  // Quem originou a proposta. Nullable porque bookings anteriores a este campo
  // não têm como saber — o consumidor trata null como "não registrado" e age de
  // forma conservadora (ver booking-lifecycle no soundmeet-web).
  proposed_by             String? // "establishment" | "musician" | "band"
  cancelled_by            String? // "establishment" | "musician" | "band"
  cancellation_reason     String?
  buffer_minutes          Int           @default(0)
  expires_at              DateTime?
  free_cancellation_hours Int           @default(72)
  confirmed_at            DateTime?
  cancelled_at            DateTime?
  completed_at            DateTime?
  /// Registro da apresentação pelo artista ("check-in"). É a prova de execução
  /// do serviço — vale contra chargeback mesmo sem escrow (camada 3), e é a
  /// primeira das duas condições que liberam a custódia.
  checked_in_at           DateTime?
  checked_in_by           String? // "musician" | "band"
  /// Contestação do estabelecimento dentro da janela. Congela a liberação
  /// automática e manda o caso para mediação.
  disputed_at             DateTime?
  dispute_reason          String?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  establishment                Establishment              @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  event                        Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  musician                     Musician?                  @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band                         Band?                      @relation(fields: [bandId], references: [id], onDelete: SetNull)
  inquiry                      Inquiry?                   @relation("InquiryBooking")
  google_calendar_synced_event GoogleCalendarSyncedEvent?
  contracts                    Contract[]
  escrow                       BookingEscrow?

  @@index([musicianId, start_at, end_at])
  @@index([bandId, start_at, end_at])
  @@index([establishmentId, start_at, end_at])
  @@map("bookings")
}

model Inquiry {
  id               String        @id @default(uuid())
  establishmentId  String
  eventId          String?
  musicianId       String?
  bandId           String?
  subject          String?
  initial_message  String?
  status           InquiryStatus @default(open)
  expires_at       DateTime?
  accepted_at      DateTime?
  rejected_at      DateTime?
  rejection_reason String?
  converted_at     DateTime?
  bookingId        String?       @unique
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  musician      Musician?     @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band          Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)
  booking       Booking?      @relation("InquiryBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  conversation  Conversation?

  @@index([musicianId, status, created_at])
  @@index([bandId, status, created_at])
  @@index([establishmentId, status, created_at])
  @@map("inquiries")
}

model Conversation {
  id               String    @id @default(uuid())
  inquiry_id       String    @unique
  establishment_id String
  musician_id      String?
  band_id          String?
  messages         Message[]
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  inquiry Inquiry @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model Message {
  id              String    @id @default(uuid())
  conversation_id String
  sender_id       String
  sender_type     String
  content         String    @db.Text
  status          String    @default("sent")
  created_at      DateTime  @default(now())
  read_at         DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("messages")
}

model MusicianCalendarSettings {
  id                     String   @id @default(uuid())
  musicianId             String   @unique
  timezone               String   @default("UTC")
  default_buffer_minutes Int      @default(0)
  max_shows_per_day      Int?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_calendar_settings")
}

// Integração Google Calendar (OAuth próprio do músico — tokens cifrados AES-256-GCM,
// nunca em texto claro; client OAuth separado do login social via Keycloak)
model GoogleCalendarIntegration {
  id                     String    @id @default(uuid())
  musicianId             String    @unique
  googleAccountEmail     String
  accessTokenCiphertext  String?
  accessTokenIv          String?
  accessTokenAuthTag     String?
  refreshTokenCiphertext String?
  refreshTokenIv         String?
  refreshTokenAuthTag    String?
  tokenExpiresAt         DateTime?
  scope                  String?
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("google_calendar_integrations")
}

// Mapeamento Booking → evento no Google Calendar do músico. Status operacional
// de sync como String (telemetria evolutiva, convenção dos workers — nunca enum)
model GoogleCalendarSyncedEvent {
  id            String    @id @default(uuid())
  bookingId     String    @unique
  musicianId    String
  googleEventId String?
  status        String    @default("pending") // pending | synced | failed | deleted
  lastError     String?
  syncedAt      DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([musicianId])
  @@map("google_calendar_synced_events")
}

model MusicianAvailabilityRule {
  id           String   @id @default(uuid())
  musicianId   String
  weekday      Int
  start_time   String
  end_time     String
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, weekday])
  @@map("musician_availability_rules")
}

model MusicianUnavailability {
  id         String   @id @default(uuid())
  musicianId String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, start_at, end_at])
  @@map("musician_unavailability")
}

model BandCalendarSettings {
  id                     String   @id @default(uuid())
  bandId                 String   @unique
  timezone               String   @default("UTC")
  default_buffer_minutes Int      @default(0)
  max_shows_per_day      Int?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_calendar_settings")
}

model BandUnavailability {
  id         String   @id @default(uuid())
  bandId     String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId, start_at, end_at])
  @@map("band_unavailability")
}

// ========================================
// DOMÍNIO AUDIENCE
// ========================================

model Audience {
  id                     String    @id @default(uuid())
  email                  String    @unique
  name                   String
  nickname               String?
  avatar                 String?
  phone                  String?
  points                 Int       @default(0)
  monthly_points         Int       @default(0)
  level                  Int       @default(1)
  last_points_update     DateTime  @default(now())
  favorite_genres        String[]  @default([])
  favorite_artists       String[]  @default([])
  favorite_instruments   String[]  @default([])
  preferred_languages    String[]  @default(["pt-BR"])
  location               Json? // {latitude, longitude, city, state} para descoberta por proximidade
  social_links           Json? // Links para redes sociais
  notification_settings  Json? // Configurações de notificação
  privacy_settings       Json? // Configurações de privacidade
  discovery_settings     Json? // Configurações de descoberta musical
  is_active              Boolean   @default(true)
  email_verified_at      DateTime?
  email_pending          String?
  // Legado (SM-016) — ver comentário equivalente em Musician.email_token.
  email_token            String?
  email_token_hash       String?
  email_token_expires_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Relacionamentos
  requests       MusicRequest[]
  votes          RequestVote[]
  tips           Tip[]
  attendances    EventAttendee[]
  points_summary UserPoints?
  badges         UserBadge[]
  interactions   UserInteraction[]
  scores         UserScore[]
  rankings       Ranking[]
  transactions   Transaction[]
  spotify_link   AudienceSpotifyLink?

  @@map("audiences")
}

/// Vínculo OAuth da conta Spotify de um fã — "gostei ao vivo, salva pra mim".
///
/// Tabela própria, e não colunas em `audiences`, pelo mesmo motivo de
/// `MusicianWallet` guardar os tokens do Mercado Pago fora de `Musician`: token
/// de terceiro tem ciclo de vida próprio (expira, renova, é revogado) e quase
/// nunca é lido junto do perfil.
model AudienceSpotifyLink {
  id                     String   @id @default(uuid())
  audienceId             String   @unique
  /// Id da conta no provedor. Único: uma conta Spotify não se vincula a dois
  /// fãs — seria salvar música de estranhos na biblioteca de alguém.
  spotifyUserId          String   @unique
  /// 🔴 Tokens cifrados em repouso (AES-256-GCM, infra de SM-016). O
  /// access_token ESCREVE na biblioteca do fã.
  accessTokenCiphertext  String
  accessTokenIv          String
  accessTokenAuthTag     String
  /// Sem o refresh o vínculo morre em ~1h e o fã reautorizaria a cada música.
  refreshTokenCiphertext String
  refreshTokenIv         String
  refreshTokenAuthTag    String
  /// Quando o access_token expira. O job de renovação varre por esta coluna.
  expiresAt              DateTime
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("audience_spotify_links")
}

model EventAttendee {
  id         String    @id @default(uuid())
  eventId    String
  audienceId String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  is_active  Boolean   @default(true)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([eventId, audienceId])
  @@map("event_attendees")
}

model UserInteraction {
  id         String   @id @default(uuid())
  audienceId String
  musicianId String?
  type       String // "scan_qr", "tip", "request", "share", "follow"
  metadata   Json? // Dados adicionais da interação
  points     Int      @default(0)
  created_at DateTime @default(now())

  audience Audience  @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)

  @@index([audienceId, type, created_at])
  @@map("user_interactions")
}

// ========================================
// DOMÍNIO REQUEST
// ========================================

model MusicRequest {
  id              String             @id @default(uuid())
  eventId         String
  audienceId      String
  musicianId      String
  libraryId       String?
  songTitle       String
  artistName      String
  message         String?
  status          MusicRequestStatus @default(pending)
  rejectionReason String?
  priority        Int                @default(0)
  votesCount      Int                @default(0)
  playedAt        DateTime?
  respondedAt     DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience        Audience         @relation(fields: [audienceId], references: [id], onDelete: Cascade)
