// ========================================
// DOMÍNIO PERSONAL CHORD SHEET — CIFRA PESSOAL
// ========================================

/// Versão pessoal que o músico tem de uma cifra gerada pela IA.
/// Guarda O QUE ELE MUDOU (overlay), não uma cópia: a cifra original em
/// music_library.chord_sheet permanece imutável e continua servida a todos.
model PersonalChordSheet {
  id               String @id @default(uuid())
  musician_id      String
  music_library_id String

  /// Cópia de MusicLibrary.chord_sheet_version no fork. ADVISORY: não detecta
  /// re-análise da IA (updateChords não bumpa a versão) — ver base_fingerprint.
  base_version Int @default(0)

  /// sha256 hex do timeline normalizado de acordes — o sinal REAL de que a IA
  /// re-analisou a música e há reconciliação a fazer.
  base_fingerprint String @db.VarChar(64)

  /// CHORD_SHEET_FINGERPRINT_VERSION vigente no fork. Distingue "a IA mudou"
  /// de "nosso normalizador mudou": só o primeiro caso avisa o músico.
  base_pipeline_version Int @default(1)

  /// ChordEdit[] — operações ancoradas por (at_ms, símbolo), nunca por índice.
  edits Json?
  /// ChordSheetViewSettings — tom, capotraste, complexidade, instrumento.
  view  Json?
  notes String? @db.Text

  /// "private" | "band" | "community" — String, não enum: é escopo de produto
  /// em evolução, não máquina de estado de domínio.
  share_scope String    @default("private")
  shared_at   DateTime?

  /// "clean" | "base_updated"
  reconcile_status String @default("clean")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  musician      Musician     @relation(fields: [musician_id], references: [id], onDelete: Cascade)
  music_library MusicLibrary @relation(fields: [music_library_id], references: [id], onDelete: Cascade)

  /// "No máximo 1 fork por música por músico" garantido NO BANCO — dois POSTs
  /// simultâneos furam qualquer checagem feita só na aplicação.
  @@unique([musician_id, music_library_id])
  @@index([musician_id, updated_at])
  @@index([music_library_id, share_scope])
  @@index([share_scope, shared_at])
  @@map("personal_chord_sheets")
}

// ========================================
// DOMÍNIO REVIEW (Bloco 9.3)
// ========================================

/// Ledger de avaliações — fonte de verdade.
///
/// `Musician.rating`/`total_ratings` e `Establishment.rating`/`total_ratings`
/// continuam existindo como **projeção** (média incremental para leitura
/// barata), no mesmo par que gamificação já usa: UserScore (ledger) x
/// UserPoints (projeção). Sem este ledger não há como impedir que a mesma
/// pessoa avalie cem vezes, listar comentários, nem recalcular a média.
///
/// `target_*` e `author_*` são polimórficos (músico/estabelecimento/fã), então
/// não têm FK — mesmo precedente de `UserScore.reference_id`. A integridade é
/// garantida na aplicação, que só grava depois de carregar o alvo.
model Review {
  id String @id @default(uuid())

  /// "musician" | "establishment"
  target_type String
  target_id   String

  /// "audience" | "musician" | "establishment"
  author_type String
  author_id   String

  /// Estrela inteira de 1 a 5 (mesma convenção de RequestFeedback.rating).
  rating  Int
  comment String? @db.Text

  /// Prova do encontro: "event" (fã presente) | "booking" (show concluído).
  /// É o que torna rating farming inviável.
  context_type String
  context_id   String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// "Uma avaliação por autor, por alvo, por contexto" garantido NO BANCO —
  /// dois POSTs simultâneos furam qualquer checagem feita só na aplicação.
  @@unique([target_type, target_id, author_id, context_id])
  @@index([target_type, target_id, created_at])
  @@index([author_id, created_at])
  @@map("reviews")
}

/// Contrato digital de apresentação musical (F1.3b).
///
/// A linha guarda um SNAPSHOT CONGELADO: `parties`, `clauses` e `variables` são
/// o texto e os dados exatamente como as partes assinaram, não referências ao
/// estado atual dos agregados. Se o bar mudar de endereço depois, o contrato
/// assinado continua dizendo o que dizia — documento que muda sozinho não prova
/// nada.
///
/// As FKs são deliberadas nas duas direções: `Restrict` em booking e
/// establishment (não se apaga aquilo de que existe contrato) e `SetNull` em
/// musician/band (apagamento de conta por LGPD zera o ponteiro, e o snapshot
/// preserva a prova).
model Contract {
  id String @id @default(uuid())

  bookingId       String
  establishmentId String
  musicianId      String?
  bandId          String?

  /// Aditivo é contrato novo com revisão maior, nunca edição do anterior.
  revision Int @default(1)

  /// Versão IMUTÁVEL do template. Redação nova = versão nova.
  template_version String

  status ContractStatus @default(issued)

  /// Qualificação congelada das duas partes (ContractParty).
  parties    Json
  /// Cláusulas já renderizadas, na ordem do documento (RenderedClause[]).
  clauses    Json
  /// Variáveis resolvidas e formatadas (ContractVariables).
  variables  Json
  /// Trilha de aceites (ContractSignature[]), com IP, procedência e user-agent.
  signatures Json @default("[]")

  /// SHA-256 da serialização canônica do conteúdo — nunca dos bytes do PDF,
  /// que carregam metadados voláteis e não são determinísticos.
  content_hash String

  /// Código público curto para conferência por terceiro.
  verification_code String @unique

  /// Chaves no storage PRIVADO. Não há URL pública para contrato: o download
  /// passa por rota autorizada que faz stream do objeto.
  document_key    String?
  certificate_key String?

  issued_at    DateTime
  signed_at    DateTime?
  annulled_at  DateTime?
  annul_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  musician      Musician?     @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band          Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)

  /// Um contrato vigente por booking, garantido NO BANCO — duas entregas
  /// simultâneas do BookingConfirmedEvent furam qualquer checagem feita só na
  /// aplicação.
  @@unique([bookingId, revision])
  @@index([establishmentId, status, created_at])
  @@index([musicianId, status, created_at])
  @@index([bandId, status, created_at])
  @@map("contracts")
}

// ========================================
// DOMÍNIO PERFORMANCE — APRESENTAÇÃO AO VIVO
// ========================================

/// Registro de execução ao vivo (F0) — a primitiva que faltava para o sistema
/// saber o que o músico TOCOU, e não apenas o que ele sabe tocar.
///
/// Ver `Docs/performance/live-performance.md`. Três read models dependem desta
/// tabela: relatório pós-show (F6), currículo verificado (F4) e setlist
/// inteligente (F5).
///
/// 🔴 O set é aberto EXPLICITAMENTE pelo músico. Sem set aberto o Play Mode
/// continua privado — registro automático transformaria ensaio em histórico
/// público e envenenaria os três read models com repetição de estudo.
model Performance {
  id              String            @id @default(uuid())
  eventId         String
  establishmentId String
  /// Quem OPERA o set — é este id que o MusicianOwnershipGuard autoriza.
  /// Num show de banda é o dono do celular que está rodando o app.
  musicianId      String
  /// Em nome de quem se toca, quando é banda. Não substitui `musicianId`.
  bandId          String?
  /// Enum, e não String: é máquina de estado de DOMÍNIO (live -> ended), não
  /// telemetria evolutiva de worker — a regra do projeto separa os dois casos.
  status          PerformanceStatus @default(live)
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  musician      Musician        @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  band          Band?           @relation(fields: [bandId], references: [id], onDelete: SetNull)
  songs         PerformedSong[]

  /// ⚠️ Existe também o índice parcial ÚNICO
  /// `performances_one_live_per_event_musician` —
  /// `(eventId, musicianId) WHERE status = 'live'` — criado em
  /// 20260821200000_add_performance. Prisma não sabe expressar índice parcial,
  /// então ele vive só no SQL: se algum `migrate dev` gerar um DROP INDEX dele,
  /// **remova esse DROP** e mantenha o índice. É ele que impede dois sets ao
  /// vivo simultâneos — que dariam "tocando agora" ambíguo para o fã.
  @@index([musicianId, startedAt])
  @@index([establishmentId, startedAt])
  @@index([eventId, status])
  @@map("performances")
}

enum PerformanceStatus {
  live
  ended
}

/// Uma música executada dentro de um set. Entidade embutida do agregado
/// `Performance` — mesmo padrão de `RepertoireSong`.
model PerformedSong {
  id             String    @id @default(uuid())
  performanceId  String
  /// Ponteiro para a biblioteca, quando a música veio de lá. É o que o F5
  /// cruza. Null quando o músico tocou algo que não está cadastrado.
  libraryId      String?
  /// Preenchido quando a execução atende a um pedido do público.
  requestId      String?
  /// 🔴 SNAPSHOT, não referência. Renomear a música na biblioteca não pode
  /// reescrever o histórico do show — e é ESTE par que o fã vê no palco.
  title          String
  artist         String
  /// Faixa no Spotify, copiada de `music_library` no momento da execução.
  /// Snapshot pelo mesmo motivo de title/artist, e por um segundo: a leitura
  /// do fã é POLLING de 20s — resolver por join a cada consulta multiplicaria
  /// a carga pelo número de pessoas na casa.
  spotifyTrackId String?
  position       Int
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  created_at     DateTime  @default(now())

  performance Performance   @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  library     MusicLibrary? @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  request     MusicRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  /// Tocar o mesmo PEDIDO duas vezes contaria dobrado no relatório e no
  /// ranking do setlist. Música repetida sem pedido continua permitida — bis
  /// existe.
  @@unique([performanceId, requestId])
  @@unique([performanceId, position])
  @@index([performanceId, position])
  @@index([libraryId])
  @@map("performed_songs")
}
