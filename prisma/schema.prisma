// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =================== =====================
// ENUMS COMPARTILHADOS
// ========================================

enum CurrencyEnum {
  BRL
  USD
  EUR
}

// =================== =====================
// DOMÍNIO MUSICIAN
// ========================================

model Musician {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  stage_name       String?
  bio              String?
  avatar           String?
  phone            String?
  genres           String[] @default([])
  instruments      String[] @default([])
  experience_years Int?
  qr_code          String?  @unique
  rating           Float    @default(0)
  total_ratings    Int      @default(0)
  is_active        Boolean  @default(true)
  is_verified      Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relacionamentos
  profile            MusicianProfile?
  bands              BandMember[]
  requests           MusicRequest[]
  tips               Tip[]
  events             EventMusician[]
  analytics          MusicianAnalytics[]
  library            MusicLibrary[]
  interactions       UserInteraction[]
  bookings           Booking[]
  inquiries          Inquiry[]
  calendar_settings  MusicianCalendarSettings?
  availability_rules MusicianAvailabilityRule[]
  unavailabilities   MusicianUnavailability[]

  @@map("musicians")
}

model MusicianProfile {
  id             String        @id @default(uuid())
  musicianId     String        @unique
  instruments    String[] // ["guitar", "vocals", "piano"]
  genres         String[] // ["rock", "pop", "jazz"]
  experience     Int // anos de experiência
  price_model    String? // "per_event" | "per_hour"
  price_min      Float?
  price_max      Float?
  price_currency CurrencyEnum? @default(BRL)
  price_notes    String?
  location       Json // {city: "São Paulo", state: "SP", coordinates: {lat: -23.5505, lng: -46.6333}}
  socialLinks    Json? // {instagram: "@musician", youtube: "channel"}
  rating         Float         @default(0)
  totalRatings   Int           @default(0)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_profiles")
}

model Band {
  id             String        @id @default(uuid())
  name           String
  description    String?
  avatar         String?
  genres         String[]
  price_model    String? // "per_event" | "per_hour"
  price_min      Float?
  price_max      Float?
  price_currency CurrencyEnum? @default(BRL)
  price_notes    String?
  is_active      Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  members            BandMember[]
  events             EventMusician[]
  tips               Tip[]
  bookings           Booking[]
  inquiries          Inquiry[]
  calendar_settings  BandCalendarSettings?
  availability_rules BandAvailabilityRule[]
  unavailabilities   BandUnavailability[]

  @@map("bands")
}

model BandAvailabilityRule {
  id           String   @id @default(uuid())
  bandId       String
  weekday      Int
  start_time   String
  end_time     String
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId, weekday])
  @@map("band_availability_rules")
}

model BandMember {
  id         String   @id @default(uuid())
  bandId     String
  musicianId String
  role       String // "leader", "member"
  instrument String
  joinedAt   DateTime @default(now())

  band     Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@unique([bandId, musicianId])
  @@map("band_members")
}

model MusicLibrary {
  id         String   @id @default(uuid())
  musicianId String
  title      String
  artist     String
  genre      String?
  key        String? // Tom da música
  bpm        Int?
  lyrics     String?
  chords     Json? // Cifras customizadas
  notes      String? // Anotações pessoais
  difficulty Int      @default(1) // 1-5
  isFavorite Boolean  @default(false)
  source     String? // "cifra_club", "ultimate_guitar", "custom"
  sourceId   String? // ID da fonte externa
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  musician Musician       @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  requests MusicRequest[]

  @@map("music_library")
}

// ========================================
// DOMÍNIO ESTABLISHMENT - BAR, RESTAURANT, CLUB, VENUE
// ========================================

model Establishment {
  id          String  @id @default(uuid())
  email       String  @unique
  name        String
  description String?
  avatar      String?
  cnpj        String? @unique
  phone       String?
  website     String?

  establishment_type String
  qr_code            String? @unique
  rating             Float   @default(0)
  total_ratings      Int     @default(0)

  is_active   Boolean  @default(true)
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relacionamentos
  profile   EstablishmentProfile?
  events    Event[]
  bookings  Booking[]
  inquiries Inquiry[]
  analytics EstablishmentAnalytics[]
  rankings  Ranking[]

  @@map("establishments")
}

model EstablishmentProfile {
  id              String   @id @default(uuid())
  establishmentId String   @unique
  capacity        Int?
  location        Json
  location_city   String
  location_lat    Float?
  location_lng    Float?
  amenities       String[] @default([]) // ["sound_system", "stage", "parking"]
  preferredGenres String[] @default([])
  operatingHours  Json?
  priceRange      Json?
  socialLinks     Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([location_city])
  @@index([location_lat, location_lng])
  @@index([capacity])
  @@index([amenities], type: Gin)
  @@index([preferredGenres], type: Gin)
  @@map("establishment_profiles")
}

model Event {
  id              String   @id @default(uuid())
  establishmentId String
  name            String
  description     String?
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  status          String   @default("scheduled") // "scheduled", "active", "completed", "cancelled"
  maxCapacity     Int?
  currentCapacity Int      @default(0)
  isPublic        Boolean  @default(true)
  coverCharge     Float?   @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  musicians     EventMusician[]
  requests      MusicRequest[]
  attendees     EventAttendee[]
  bookings      Booking[]
  inquiries     Inquiry[]
  tips          Tip[]

  @@map("events")
}

model EventMusician {
  id         String    @id @default(uuid())
  eventId    String
  musicianId String?
  bandId     String?
  fee        Float?
  status     String    @default("confirmed") // "confirmed", "pending", "cancelled"
  startTime  DateTime?
  endTime    DateTime?
  created_at DateTime  @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)

  @@map("event_musicians")
}

model Booking {
  id                      String    @id @default(uuid())
  establishmentId         String
  eventId                 String?
  musicianId              String?
  bandId                  String?
  start_at                DateTime
  end_at                  DateTime
  fee                     Float? // Custo da reserva
  status                  String    @default("pending") // "pending", "confirmed", "cancelled", "completed"
  notes                   String? // Notas adicionais sobre a reserva
  buffer_minutes          Int       @default(0)
  expires_at              DateTime?
  free_cancellation_hours Int       @default(72)
  confirmed_at            DateTime?
  cancelled_at            DateTime?
  completed_at            DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  musician      Musician?     @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band          Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)
  inquiry       Inquiry?      @relation("InquiryBooking")

  @@index([musicianId, start_at, end_at])
  @@index([bandId, start_at, end_at])
  @@index([establishmentId, start_at, end_at])
  @@map("bookings")
}

model Inquiry {
  id               String    @id @default(uuid())
  establishmentId  String
  eventId          String?
  musicianId       String?
  bandId           String?
  subject          String?
  initial_message  String?
  status           String    @default("open") // "open", "accepted", "rejected", "converted", "expired"
  expires_at       DateTime?
  accepted_at      DateTime?
  rejected_at      DateTime?
  rejection_reason String?
  converted_at     DateTime?
  bookingId        String?   @unique
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  musician      Musician?     @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band          Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)
  booking       Booking?      @relation("InquiryBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([musicianId, status, created_at])
  @@index([bandId, status, created_at])
  @@index([establishmentId, status, created_at])
  @@map("inquiries")
}

model MusicianCalendarSettings {
  id                     String   @id @default(uuid())
  musicianId             String   @unique
  timezone               String   @default("UTC")
  default_buffer_minutes Int      @default(0)
  max_shows_per_day      Int?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_calendar_settings")
}

model MusicianAvailabilityRule {
  id           String   @id @default(uuid())
  musicianId   String
  weekday      Int
  start_time   String
  end_time     String
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, weekday])
  @@map("musician_availability_rules")
}

model MusicianUnavailability {
  id         String   @id @default(uuid())
  musicianId String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, start_at, end_at])
  @@map("musician_unavailability")
}

model BandCalendarSettings {
  id                     String   @id @default(uuid())
  bandId                 String   @unique
  timezone               String   @default("UTC")
  default_buffer_minutes Int      @default(0)
  max_shows_per_day      Int?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_calendar_settings")
}

model BandUnavailability {
  id         String   @id @default(uuid())
  bandId     String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId, start_at, end_at])
  @@map("band_unavailability")
}

// ========================================
// DOMÍNIO AUDIENCE
// ========================================

model Audience {
  id                    String   @id @default(uuid())
  email                 String   @unique
  name                  String
  nickname              String?
  avatar                String?
  phone                 String?
  points                Int      @default(0)
  monthly_points        Int      @default(0)
  level                 Int      @default(1)
  last_points_update    DateTime @default(now())
  favorite_genres       String[] @default([])
  favorite_artists      String[] @default([])
  favorite_instruments  String[] @default([])
  preferred_languages   String[] @default(["pt-BR"])
  location              Json? // {latitude, longitude, city, state} para descoberta por proximidade
  social_links          Json? // Links para redes sociais
  notification_settings Json? // Configurações de notificação
  privacy_settings      Json? // Configurações de privacidade
  discovery_settings    Json? // Configurações de descoberta musical
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relacionamentos
  requests       MusicRequest[]
  votes          RequestVote[]
  tips           Tip[]
  attendances    EventAttendee[]
  points_history UserPoints[]
  badges         UserBadge[]
  interactions   UserInteraction[]
  scores         UserScore[]
  rankings       Ranking[]

  @@map("audiences")
}

model EventAttendee {
  id         String    @id @default(uuid())
  eventId    String
  audienceId String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  is_active  Boolean   @default(true)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([eventId, audienceId])
  @@map("event_attendees")
}

model UserInteraction {
  id         String   @id @default(uuid())
  audienceId String
  musicianId String?
  type       String // "scan_qr", "tip", "request", "share", "follow"
  metadata   Json? // Dados adicionais da interação
  points     Int      @default(0)
  created_at DateTime @default(now())

  audience Audience  @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)

  @@map("user_interactions")
}

// ========================================
// DOMÍNIO REQUEST
// ========================================

model MusicRequest {
  id         String    @id @default(uuid())
  eventId    String
  audienceId String
  musicianId String
  libraryId  String?
  songTitle  String
  artistName String
  message    String?
  status     String    @default("pending") // "pending", "accepted", "rejected", "played"
  rejectionReason String?
  priority   Int       @default(0)
  votesCount Int       @default(0)
  playedAt   DateTime?
  respondedAt DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience Audience         @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  musician Musician         @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  library  MusicLibrary?    @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  votes    RequestVote[]
  feedback RequestFeedback?

  @@index([audienceId, created_at])
  @@index([musicianId, created_at])
  @@index([eventId, created_at])
  @@index([status, created_at])
  @@index([eventId, musicianId])
  @@index([audienceId, musicianId, status])
  @@map("music_requests")
}

model RequestVote {
  id         String   @id @default(uuid())
  requestId  String
  audienceId String
  voteType   String // "up", "down"
  created_at DateTime @default(now())

  request  MusicRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  audience Audience     @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([requestId, audienceId])
  @@map("request_votes")
}

model RequestFeedback {
  id         String   @id @default(uuid())
  requestId  String   @unique
  rating     Int // 1-5
  comment    String?
  created_at DateTime @default(now())

  request MusicRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_feedback")
}

// ========================================
// DOMÍNIO GAMIFICATION
// ========================================

model UserPoints {
  id          String   @id @default(uuid())
  audienceId  String
  points      Int
  source      String // "scan_qr", "request", "tip", "share", "accepted_request"
  description String?
  metadata    Json? // Dados adicionais
  created_at  DateTime @default(now())

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  category    String // "engagement", "support", "discovery", "social"
  requirement Json // Critérios para conquistar
  points      Int      @default(0)
  rarity      String   @default("common") // "common", "rare", "epic", "legendary"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid())
  audienceId String
  badgeId    String
  earnedAt   DateTime @default(now())
  progress   Json? // Progresso para badges com múltiplos níveis

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([audienceId, badgeId])
  @@map("user_badges")
}

model UserScore {
  id           String   @id @default(uuid())
  user_id      String
  score_type   String // "qr_scan", "tip_given", "social_share", etc.
  points       Int      @default(0)
  reference_id String? // ID da referência (tip, evento, etc.)
  description  String?
  created_at   DateTime @default(now())

  audience Audience @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_scores")
}

model Ranking {
  id               String   @id @default(uuid())
  type             String // "monthly_fans", "top_supporters", "discoverers"
  period           String // "2024-01", "2024-02"
  user_id          String
  establishment_id String?
  position         Int
  score            Int
  period_start     DateTime
  period_end       DateTime
  is_active        Boolean  @default(true)
  metadata         Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  audience      Audience       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishment_id], references: [id], onDelete: SetNull)

  @@index([type, period])
  @@index([user_id, type, period])
  @@index([establishment_id, type, period])
  @@map("rankings")
}

// ========================================
// DOMÍNIO PAYMENT
// ========================================

model Tip {
  id            String   @id @default(uuid())
  audienceId    String
  musicianId    String?
  bandId        String?
  eventId       String?
  amount        Float
  message       String?
  paymentMethod String // "pix", "credit_card", "wallet"
  status        String   @default("pending") // "pending", "completed", "failed", "refunded"
  transactionId String?
  pixKey        String?
  pixKeyType    String?
  isAnonymous   Boolean  @default(false)
  showInWall    Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  audience Audience  @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("tips")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String?
  musicianId    String?
  bandId        String?
  type          String // "tip", "booking_fee", "commission"
  amount        Float
  fee           Float    @default(0)
  netAmount     Float
  status        String   @default("pending")
  paymentMethod String
  externalId    String? // ID do provedor de pagamento
  metadata      Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("transactions")
}

model MusicianWallet {
  id             String   @id @default(uuid())
  musicianId     String   @unique
  balance        Float    @default(0)
  totalEarned    Float    @default(0)
  totalWithdrawn Float    @default(0)
  pixKey         String?
  pixKeyType     String?
  bankAccount    Json? // Dados bancários
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("musician_wallets")
}

// ========================================
// ANALYTICS E MÉTRICAS
// ========================================

model MusicianAnalytics {
  id               String   @id @default(uuid())
  musicianId       String
  date             DateTime @db.Date
  profileViews     Int      @default(0)
  qrScans          Int      @default(0)
  requestsReceived Int      @default(0)
  requestsAccepted Int      @default(0)
  tipsReceived     Int      @default(0)
  totalTipAmount   Float    @default(0)
  socialShares     Int      @default(0)
  newFollowers     Int      @default(0)
  engagementScore  Float    @default(0)
  created_at       DateTime @default(now())

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@unique([musicianId, date])
  @@map("musician_analytics")
}

model EstablishmentAnalytics {
  id              String   @id @default(uuid())
  establishmentId String
  date            DateTime @db.Date
  eventsHosted    Int      @default(0)
  totalAttendees  Int      @default(0)
  musiciansHired  Int      @default(0)
  totalSpent      Float    @default(0)
  avgRating       Float    @default(0)
  created_at      DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, date])
  @@map("establishment_analytics")
}
