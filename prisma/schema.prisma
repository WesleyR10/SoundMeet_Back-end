// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =================== =====================
// ENUMS COMPARTILHADOS
// ========================================

enum CurrencyEnum {
  BRL
  USD
  EUR
}

// Enums de máquina de estado de domínio (valores idênticos aos VOs/uniões do domínio).
// Status operacionais de worker (ai-audio, ai-cifra, synced-lyrics) permanecem String
// por serem telemetria evolutiva, não máquinas de estado de domínio.
enum EventStatus {
  scheduled
  active
  completed
  cancelled
}

enum EventMusicianStatus {
  confirmed
  pending
  cancelled
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  expired
}

enum InquiryStatus {
  open
  accepted
  rejected
  converted
  expired
}

enum TipStatus {
  pending
  completed
  failed
  refunded
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum MusicRequestStatus {
  pending
  accepted
  rejected
  played
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

// =================== =====================
// DOMÍNIO MUSICIAN
// ========================================

model Musician {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  stage_name       String?
  bio              String?
  avatar           String?
  phone            String?
  genres           String[] @default([])
  instruments      String[] @default([])
  experience_years Int?
  qr_code          String?  @unique
  rating           Float    @default(0)
  total_ratings    Int      @default(0)
  is_active        Boolean  @default(true)
  is_verified      Boolean  @default(false)
  email_verified_at      DateTime?
  email_pending          String?
  email_token            String?
  email_token_expires_at DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relacionamentos
  profile                  MusicianProfile?
  bands                    BandMember[]
  requests                 MusicRequest[]
  tips                     Tip[]
  events                   EventMusician[]
  analytics                MusicianAnalytics[]
  library                  MusicLibrary[]
  interactions             UserInteraction[]
  bookings                 Booking[]
  inquiries                Inquiry[]
  calendar_settings        MusicianCalendarSettings?
  availability_rules       MusicianAvailabilityRule[]
  unavailabilities         MusicianUnavailability[]
  ai_audio_uploads         AiAudioUpload[]
  ai_audio_separation_jobs AiAudioSeparationJob[]
  ai_cifra_uploads         AiCifraUpload[]
  ai_cifra_analysis_jobs   AiCifraAnalysisJob[]
  synced_lyrics_bulk_jobs  SyncedLyricsBulkJob[]
  wallet                   MusicianWallet?
  transactions             Transaction[]
  subscriptions            Subscription[]
  repertoires              Repertoire[]

  @@map("musicians")
}

model MusicianProfile {
  id             String        @id @default(uuid())
  musicianId     String        @unique
  price_model    String? // "per_event" | "per_hour"
  price_min      Decimal?      @db.Decimal(12, 2)
  price_max      Decimal?      @db.Decimal(12, 2)
  price_currency CurrencyEnum? @default(BRL)
  price_notes    String?
  location       Json // {city: "São Paulo", state: "SP", coordinates: {lat: -23.5505, lng: -46.6333}}
  socialLinks    Json? // {instagram: "@musician", youtube: "channel"}
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_profiles")
}

model Band {
  id             String        @id @default(uuid())
  name           String
  description    String?
  avatar         String?
  genres         String[]
  qr_code        String?       @unique
  price_model    String? // "per_event" | "per_hour"
  price_min      Decimal?      @db.Decimal(12, 2)
  price_max      Decimal?      @db.Decimal(12, 2)
  price_currency CurrencyEnum? @default(BRL)
  price_notes    String?
  is_active      Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  members            BandMember[]
  events             EventMusician[]
  tips               Tip[]
  bookings           Booking[]
  inquiries          Inquiry[]
  calendar_settings  BandCalendarSettings?
  availability_rules BandAvailabilityRule[]
  unavailabilities   BandUnavailability[]
  transactions       Transaction[]

  @@map("bands")
}

model BandAvailabilityRule {
  id           String   @id @default(uuid())
  bandId       String
  weekday      Int
  start_time   String
  end_time     String
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId, weekday])
  @@map("band_availability_rules")
}

model BandMember {
  id         String   @id @default(uuid())
  bandId     String
  musicianId String
  role       String // "leader", "member"
  instrument String
  joinedAt   DateTime @default(now())

  band     Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@unique([bandId, musicianId])
  @@index([bandId, role])
  @@map("band_members")
}

model MusicLibrary {
  id                             String    @id @default(uuid())
  musicianId                     String
  title                          String
  artist                         String
  genre                          String?
  key                            String? // Tom da música
  bpm                            Int?
  lyrics                         String?
  chords                         Json? // Cifras customizadas
  structure_segments             Json? // Segmentação estrutural (ex.: intro/verse/chorus)
  chord_sheet                    Json?
  chord_sheet_version            Int       @default(0)
  renderable_chord_sheet         Json?
  renderable_chord_sheet_version Int       @default(0)
  notes                          String? // Anotações pessoais
  difficulty                     Int       @default(1) // 1-5
  isFavorite                     Boolean   @default(false)
  source                         String? // "cifra_club", "ultimate_guitar", "custom"
  sourceId                       String? // ID da fonte externa
  // [SyncedLyrics] — campos abaixo são gerenciados exclusivamente por SyncedLyricsModelMapper.
  // NÃO escrever via MusicLibraryModelMapper. Aggregate: SyncedLyrics em src/core/synced-lyrics/.
  lrc_raw                        String?
  lrc_normalized                 Json?
  lrc_provider                   String?
  lrc_provider_meta              Json?
  lrc_hash                       String?
  lrc_version                    Int       @default(1)
  lrc_pipeline_version           Int       @default(1)
  lrc_quality_flags              String[]  @default([])
  lrc_coverage_ms                Int?
  lrc_has_word_timestamps        Boolean   @default(false)
  lrc_last_synced_at             DateTime?
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  duration_seconds               Int?

  musician         Musician        @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  requests         MusicRequest[]
  ai_cifra_uploads AiCifraUpload[]
  repertoire_songs RepertoireSong[]

  @@index([artist, title])
  @@index([lrc_hash])
  @@map("music_library")
}

// ========================================
// DOMÍNIO ESTABLISHMENT - BAR, RESTAURANT, CLUB, VENUE
// ========================================

model Establishment {
  id          String  @id @default(uuid())
  email       String  @unique
  name        String
  description String?
  avatar      String?
  cnpj        String? @unique
  phone       String?
  website     String?

  establishment_type String
  qr_code            String? @unique
  rating             Float   @default(0)
  total_ratings      Int     @default(0)

  is_active              Boolean   @default(true)
  is_verified            Boolean   @default(false)
  email_verified_at      DateTime?
  email_pending          String?
  email_token            String?
  email_token_expires_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Relacionamentos
  profile       EstablishmentProfile?
  events        Event[]
  bookings      Booking[]
  inquiries     Inquiry[]
  analytics     EstablishmentAnalytics[]
  rankings      Ranking[]
  subscriptions Subscription[]
  campaigns     Campaign[]

  @@map("establishments")
}

model EstablishmentProfile {
  id              String   @id @default(uuid())
  establishmentId String   @unique
  capacity        Int?
  location        Json
  location_city   String
  location_lat    Float?
  location_lng    Float?
  amenities       String[] @default([]) // ["sound_system", "stage", "parking"]
  preferredGenres String[] @default([])
  operatingHours      Json?
  priceRange          Json?
  socialLinks         Json?
  menu_pdfs           Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([location_city])
  @@index([location_lat, location_lng])
  @@index([capacity])
  @@index([amenities], type: Gin)
  @@index([preferredGenres], type: Gin)
  @@map("establishment_profiles")
}

model Event {
  id              String   @id @default(uuid())
  establishmentId String
  name            String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          EventStatus @default(scheduled)
  maxCapacity     Int?
  currentCapacity Int      @default(0)
  isPublic        Boolean  @default(true)
  coverCharge     Float?   @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  musicians     EventMusician[]
  requests      MusicRequest[]
  attendees     EventAttendee[]
  bookings      Booking[]
  inquiries     Inquiry[]
  tips          Tip[]

  @@map("events")
}

model EventMusician {
  id         String    @id @default(uuid())
  eventId    String
  musicianId String?
  bandId     String?
  fee        Decimal?  @db.Decimal(12, 2)
  status     EventMusicianStatus @default(confirmed)
  startTime  DateTime?
  endTime    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)

  @@map("event_musicians")
}

model Booking {
  id                      String    @id @default(uuid())
  establishmentId         String
  eventId                 String?
  musicianId              String?
  bandId                  String?
  start_at                DateTime
  end_at                  DateTime
  fee                     Decimal?  @db.Decimal(12, 2) // Custo da reserva
  status                  BookingStatus @default(pending)
  notes                   String? // Notas adicionais sobre a reserva
  cancelled_by            String? // "establishment" | "musician" | "band"
  cancellation_reason     String?
  buffer_minutes          Int       @default(0)
  expires_at              DateTime?
  free_cancellation_hours Int       @default(72)
  confirmed_at            DateTime?
  cancelled_at            DateTime?
  completed_at            DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  musician      Musician?     @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band          Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)
  inquiry       Inquiry?      @relation("InquiryBooking")

  @@index([musicianId, start_at, end_at])
  @@index([bandId, start_at, end_at])
  @@index([establishmentId, start_at, end_at])
  @@map("bookings")
}

model Inquiry {
  id               String    @id @default(uuid())
  establishmentId  String
  eventId          String?
  musicianId       String?
  bandId           String?
  subject          String?
  initial_message  String?
  status           InquiryStatus @default(open)
  expires_at       DateTime?
  accepted_at      DateTime?
  rejected_at      DateTime?
  rejection_reason String?
  converted_at     DateTime?
  bookingId        String?   @unique
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  musician      Musician?     @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band          Band?         @relation(fields: [bandId], references: [id], onDelete: SetNull)
  booking       Booking?      @relation("InquiryBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([musicianId, status, created_at])
  @@index([bandId, status, created_at])
  @@index([establishmentId, status, created_at])
  @@map("inquiries")
}

model MusicianCalendarSettings {
  id                     String   @id @default(uuid())
  musicianId             String   @unique
  timezone               String   @default("UTC")
  default_buffer_minutes Int      @default(0)
  max_shows_per_day      Int?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_calendar_settings")
}

model MusicianAvailabilityRule {
  id           String   @id @default(uuid())
  musicianId   String
  weekday      Int
  start_time   String
  end_time     String
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, weekday])
  @@map("musician_availability_rules")
}

model MusicianUnavailability {
  id         String   @id @default(uuid())
  musicianId String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, start_at, end_at])
  @@map("musician_unavailability")
}

model BandCalendarSettings {
  id                     String   @id @default(uuid())
  bandId                 String   @unique
  timezone               String   @default("UTC")
  default_buffer_minutes Int      @default(0)
  max_shows_per_day      Int?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@map("band_calendar_settings")
}

model BandUnavailability {
  id         String   @id @default(uuid())
  bandId     String
  start_at   DateTime
  end_at     DateTime
  reason     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@index([bandId, start_at, end_at])
  @@map("band_unavailability")
}

// ========================================
// DOMÍNIO AUDIENCE
// ========================================

model Audience {
  id                    String   @id @default(uuid())
  email                 String   @unique
  name                  String
  nickname              String?
  avatar                String?
  phone                 String?
  points                Int      @default(0)
  monthly_points        Int      @default(0)
  level                 Int      @default(1)
  last_points_update    DateTime @default(now())
  favorite_genres       String[] @default([])
  favorite_artists      String[] @default([])
  favorite_instruments  String[] @default([])
  preferred_languages   String[] @default(["pt-BR"])
  location              Json? // {latitude, longitude, city, state} para descoberta por proximidade
  social_links          Json? // Links para redes sociais
  notification_settings Json? // Configurações de notificação
  privacy_settings      Json? // Configurações de privacidade
  discovery_settings    Json? // Configurações de descoberta musical
  is_active              Boolean   @default(true)
  email_verified_at      DateTime?
  email_pending          String?
  email_token            String?
  email_token_expires_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Relacionamentos
  requests       MusicRequest[]
  votes          RequestVote[]
  tips           Tip[]
  attendances    EventAttendee[]
  points_summary UserPoints?
  badges         UserBadge[]
  interactions   UserInteraction[]
  scores         UserScore[]
  rankings       Ranking[]
  transactions   Transaction[]

  @@map("audiences")
}

model EventAttendee {
  id         String    @id @default(uuid())
  eventId    String
  audienceId String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  is_active  Boolean   @default(true)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([eventId, audienceId])
  @@map("event_attendees")
}

model UserInteraction {
  id         String   @id @default(uuid())
  audienceId String
  musicianId String?
  type       String // "scan_qr", "tip", "request", "share", "follow"
  metadata   Json? // Dados adicionais da interação
  points     Int      @default(0)
  created_at DateTime @default(now())

  audience Audience  @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)

  @@index([audienceId, type, created_at])
  @@map("user_interactions")
}

// ========================================
// DOMÍNIO REQUEST
// ========================================

model MusicRequest {
  id              String             @id @default(uuid())
  eventId         String
  audienceId      String
  musicianId      String
  libraryId       String?
  songTitle       String
  artistName      String
  message         String?
  status          MusicRequestStatus @default(pending)
  rejectionReason String?
  priority        Int                @default(0)
  votesCount      Int                @default(0)
  playedAt        DateTime?
  respondedAt     DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience Audience         @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  musician Musician         @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  library  MusicLibrary?    @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  votes    RequestVote[]
  feedback RequestFeedback?

  @@index([audienceId, created_at])
  @@index([musicianId, created_at])
  @@index([eventId, created_at])
  @@index([status, created_at])
  @@index([eventId, musicianId])
  @@index([audienceId, musicianId, status])
  @@index([eventId, status, created_at])
  @@index([eventId, status, priority])
  @@map("music_requests")
}

model RequestVote {
  id         String   @id @default(uuid())
  requestId  String
  audienceId String
  voteType   String // "up", "down"
  created_at DateTime @default(now())

  request  MusicRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  audience Audience     @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([requestId, audienceId])
  @@map("request_votes")
}

model RequestFeedback {
  id         String   @id @default(uuid())
  requestId  String   @unique
  rating     Int // 1-5
  comment    String?
  created_at DateTime @default(now())

  request MusicRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_feedback")
}

// ========================================
// DOMÍNIO GAMIFICATION
// ========================================

// Projeção/resumo de pontuação por usuário (read model).
// A fonte de verdade (ledger imutável de eventos) é o model UserScore (user_scores).
model UserPoints {
  id                  String   @id @default(uuid())
  audienceId          String   @unique
  total_points        Int      @default(0)
  total_scans         Int      @default(0)
  total_requests      Int      @default(0)
  total_tips          Decimal  @default(0) @db.Decimal(12, 2) // soma monetária das gorjetas dadas
  total_social_shares Int      @default(0)
  current_level       Int      @default(1)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  category    String // "engagement", "support", "discovery", "social"
  requirement Json // Critérios para conquistar
  points      Int      @default(0)
  rarity      String   @default("common") // "common", "rare", "epic", "legendary"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("badges")
}

// Badges conquistados/em progresso por usuário (agregado UserBadge).
// O tipo do badge é o enum de domínio BadgeType (self-contained com pontos requeridos),
// não uma FK para o catálogo Badge.
model UserBadge {
  id          String    @id @default(uuid())
  audienceId  String
  badge_type  String
  progress    Int       @default(0)
  is_unlocked Boolean   @default(false)
  unlocked_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([audienceId, badge_type])
  @@index([badge_type])
  @@map("user_badges")
}

model UserScore {
  id           String   @id @default(uuid())
  user_id      String
  score_type   String // "qr_scan", "tip_given", "social_share", etc.
  points       Int      @default(0)
  reference_id String? // ID da referência (tip, evento, etc.)
  description  String?
  created_at   DateTime @default(now())

  audience Audience @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@map("user_scores")
}

model Ranking {
  id              String   @id @default(uuid())
  type            String // "monthly_fans", "top_supporters", "discoverers"
  period          String // "2024-01", "2024-02"
  audienceId      String   @map("user_id")
  establishmentId String?  @map("establishment_id")
  position        Int
  score           Int
  period_start    DateTime
  period_end      DateTime
  is_active       Boolean  @default(true)
  metadata        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  audience      Audience       @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@index([type, period])
  @@index([audienceId, type, period])
  @@index([establishmentId, type, period])
  @@map("rankings")
}

// ========================================
// DOMÍNIO PAYMENT
// ========================================

model Tip {
  id            String      @id @default(uuid())
  audienceId    String
  musicianId    String?
  bandId        String?
  eventId       String?
  amount        Decimal     @db.Decimal(12, 2)
  currency      CurrencyEnum @default(BRL)
  message       String?
  paymentMethod String // "pix", "credit_card", "wallet"
  status        TipStatus   @default(pending)
  transactionId String?
  pixKey        String?
  pixKeyType    String?
  isAnonymous   Boolean     @default(false)
  showInWall    Boolean     @default(true)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  audience Audience  @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([audienceId, status, created_at])
  @@index([musicianId, status, created_at])
  @@index([bandId, status, created_at])
  @@index([status, created_at])
  @@map("tips")
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String?
  musicianId    String?
  bandId        String?
  type          String // "tip", "booking_fee", "commission"
  amount        Decimal           @db.Decimal(12, 2)
  fee           Decimal           @default(0) @db.Decimal(12, 2)
  netAmount     Decimal           @db.Decimal(12, 2)
  currency      CurrencyEnum      @default(BRL)
  status        TransactionStatus @default(pending)
  paymentMethod String
  externalId    String? // ID do provedor de pagamento
  metadata      Json?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  audience Audience? @relation(fields: [userId], references: [id], onDelete: SetNull)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([musicianId])
  @@index([bandId])
  @@index([externalId])
  @@map("transactions")
}

model MusicianWallet {
  id             String       @id @default(uuid())
  musicianId     String       @unique
  balance        Decimal      @default(0) @db.Decimal(12, 2)
  totalEarned    Decimal      @default(0) @db.Decimal(12, 2)
  totalWithdrawn Decimal      @default(0) @db.Decimal(12, 2)
  currency       CurrencyEnum @default(BRL)
  pixKey         String?
  pixKeyType     String?
  bankAccount    Json? // Dados bancários
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_wallets")
}

// ========================================
// DOMÍNIO AI AUDIO
// ========================================

model AiAudioUpload {
  id                  String   @id @default(uuid())
  musicianId          String
  original_filename   String
  content_type        String
  file_size           Int
  object_key          String
  upload_method       String
  multipart_upload_id String?
  duration_seconds    Int?
  codec               String?
  sample_rate         Int?
  channels            Int?
  status              String
  rejected_reason     String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  musician Musician               @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  jobs     AiAudioSeparationJob[]

  @@index([musicianId, status, created_at])
  @@map("ai_audio_uploads")
}

model AiAudioSeparationJob {
  id               String    @id @default(uuid())
  aiAudioUploadId  String
  musicianId       String
  model_id         String
  output_prefix    String
  output_format    String?
  status           String
  progress_percent Int       @default(0)
  progress_stage   String?
  error_code       String?
  error_message    String?
  started_at       DateTime?
  finished_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  upload   AiAudioUpload             @relation(fields: [aiAudioUploadId], references: [id], onDelete: Cascade)
  musician Musician                  @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  outputs  AiAudioSeparationOutput[]

  @@index([musicianId, status, created_at])
  @@map("ai_audio_separation_jobs")
}

model AiAudioSeparationOutput {
  id           String   @id @default(uuid())
  jobId        String
  stem_name    String
  object_key   String
  content_type String
  file_size    Int?
  created_at   DateTime @default(now())

  job AiAudioSeparationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ai_audio_separation_outputs")
}

// ========================================
// DOMÍNIO AI CIFRA
// ========================================

model AiCifraUpload {
  id                String   @id @default(uuid())
  musicianId        String
  musicLibraryId    String?
  original_filename String
  content_type      String
  file_size         Int
  object_key        String
  upload_method     String
  status            String
  rejected_reason   String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  musician     Musician             @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  musicLibrary MusicLibrary?        @relation(fields: [musicLibraryId], references: [id], onDelete: SetNull)
  jobs         AiCifraAnalysisJob[]

  @@index([musicianId, status, created_at])
  @@index([musicLibraryId])
  @@map("ai_cifra_uploads")
}

model AiCifraAnalysisJob {
  id               String    @id @default(uuid())
  aiCifraUploadId  String
  musicianId       String
  model_id         String
  status           String
  progress_percent Int       @default(0)
  progress_stage   String?
  error_code       String?
  error_message    String?
  started_at       DateTime?
  finished_at      DateTime?
  bpm              Int?
  key              String?
  time_signature   String?
  chords           Json?
  segments         Json?
  artifacts        Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  upload   AiCifraUpload @relation(fields: [aiCifraUploadId], references: [id], onDelete: Cascade)
  musician Musician      @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, status, created_at])
  @@map("ai_cifra_analysis_jobs")
}

model SyncedLyricsBulkJob {
  id            String    @id @default(uuid())
  musicianId    String
  status        String
  total         Int       @default(0)
  processed     Int       @default(0)
  success       Int       @default(0)
  failed        Int       @default(0)
  error_summary Json?
  started_at    DateTime?
  finished_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, status, created_at])
  @@map("synced_lyrics_bulk_jobs")
}

// ========================================
// DOMÍNIO PLANS
// ========================================

model Subscription {
  id               String             @id @default(uuid())
  musician_id      String?
  establishment_id String?
  plan_tier        String
  persona          String // "musician" | "establishment"
  billing_cycle    String             @default("monthly") // "monthly" | "annual"
  status           SubscriptionStatus @default(active)
  started_at       DateTime           @default(now())
  expires_at       DateTime?
  trial_ends_at    DateTime?
  cancelled_at     DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  musician      Musician?      @relation(fields: [musician_id], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishment_id], references: [id], onDelete: Cascade)

  @@index([musician_id, status])
  @@index([establishment_id, status])
  @@map("subscriptions")
}

// ========================================
// ANALYTICS E MÉTRICAS
// ========================================

model MusicianAnalytics {
  id               String   @id @default(uuid())
  musicianId       String
  date             DateTime @db.Date
  profileViews     Int      @default(0)
  qrScans          Int      @default(0)
  requestsReceived Int      @default(0)
  requestsAccepted Int      @default(0)
  tipsReceived     Int      @default(0)
  totalTipAmount   Float    @default(0)
  socialShares     Int      @default(0)
  newFollowers     Int      @default(0)
  engagementScore  Float    @default(0)
  created_at       DateTime @default(now())

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@unique([musicianId, date])
  @@map("musician_analytics")
}

model EstablishmentAnalytics {
  id              String   @id @default(uuid())
  establishmentId String
  date            DateTime @db.Date
  eventsHosted    Int      @default(0)
  totalAttendees  Int      @default(0)
  musiciansHired  Int      @default(0)
  totalSpent      Float    @default(0)
  avgRating       Float    @default(0)
  created_at      DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, date])
  @@map("establishment_analytics")
}

model Campaign {
  id               String   @id @default(uuid())
  establishment_id String
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  start_date       DateTime
  end_date         DateTime
  target_genres    String[]
  status           String   @default("draft")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade)

  @@index([establishment_id])
  @@index([status])
  @@map("campaigns")
}

// ========================================
// DOMÍNIO REPERTOIRE — SETLIST DO MÚSICO
// ========================================

model Repertoire {
  id                     String   @id @default(uuid())
  musician_id            String
  name                   String   @db.VarChar(255)
  share_token            String?  @unique
  share_token_expires_at DateTime?
  is_shared              Boolean  @default(false)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  musician  Musician            @relation(fields: [musician_id], references: [id], onDelete: Cascade)
  songs     RepertoireSong[]
  invitees  RepertoireInvitee[]

  @@index([musician_id])
  @@map("repertoires")
}

model RepertoireSong {
  id                        String   @id @default(uuid())
  repertoire_id             String
  music_library_id          String
  position                  Int
  custom_notes              String?  @db.Text
  duration_override_seconds Int?
  added_at                  DateTime @default(now())

  repertoire    Repertoire   @relation(fields: [repertoire_id], references: [id], onDelete: Cascade)
  music_library MusicLibrary @relation(fields: [music_library_id], references: [id])

  @@unique([repertoire_id, music_library_id])
  @@index([repertoire_id, position])
  @@map("repertoire_songs")
}

model RepertoireInvitee {
  id            String   @id @default(uuid())
  repertoire_id String
  musician_id   String
  invited_at    DateTime @default(now())

  repertoire Repertoire @relation(fields: [repertoire_id], references: [id], onDelete: Cascade)

  @@unique([repertoire_id, musician_id])
  @@index([musician_id])
  @@map("repertoire_invitees")
}
