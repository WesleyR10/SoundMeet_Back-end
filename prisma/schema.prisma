// DOMÍNIO GAMIFICATION
// ========================================

// Projeção/resumo de pontuação por usuário (read model).
// A fonte de verdade (ledger imutável de eventos) é o model UserScore (user_scores).
model UserPoints {
  id                  String   @id @default(uuid())
  audienceId          String   @unique
  total_points        Int      @default(0)
  total_scans         Int      @default(0)
  total_requests      Int      @default(0)
  total_tips          Decimal  @default(0) @db.Decimal(12, 2) // soma monetária das gorjetas dadas
  total_social_shares Int      @default(0)
  current_level       Int      @default(1)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  category    String // "engagement", "support", "discovery", "social"
  requirement Json // Critérios para conquistar
  points      Int      @default(0)
  rarity      String   @default("common") // "common", "rare", "epic", "legendary"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("badges")
}

// Badges conquistados/em progresso por usuário (agregado UserBadge).
// O tipo do badge é o enum de domínio BadgeType (self-contained com pontos requeridos),
// não uma FK para o catálogo Badge.
model UserBadge {
  id          String    @id @default(uuid())
  audienceId  String
  badge_type  String
  progress    Int       @default(0)
  is_unlocked Boolean   @default(false)
  unlocked_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([audienceId, badge_type])
  @@index([badge_type])
  @@map("user_badges")
}

model UserScore {
  id           String   @id @default(uuid())
  user_id      String
  score_type   String // "qr_scan", "tip_given", "social_share", etc.
  points       Int      @default(0)
  reference_id String? // ID da referência (tip, evento, etc.)
  description  String?
  created_at   DateTime @default(now())

  audience Audience @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@map("user_scores")
}

model Ranking {
  id              String   @id @default(uuid())
  type            String // "monthly_fans", "top_supporters", "discoverers"
  period          String // "2024-01", "2024-02"
  audienceId      String   @map("user_id")
  establishmentId String?  @map("establishment_id")
  position        Int
  score           Int
  period_start    DateTime
  period_end      DateTime
  is_active       Boolean  @default(true)
  metadata        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  audience      Audience       @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@index([type, period])
  @@index([audienceId, type, period])
  @@index([establishmentId, type, period])
  @@map("rankings")
}

// ========================================
// DOMÍNIO PAYMENT
// ========================================

model Tip {
  id               String       @id @default(uuid())
  audienceId       String
  musicianId       String?
  bandId           String?
  eventId          String?
  amount           Decimal      @db.Decimal(12, 2)
  currency         CurrencyEnum @default(BRL)
  message          String?
  paymentMethod    String // "pix", "credit_card", "wallet"
  status           TipStatus    @default(pending)
  transactionId    String?
  // Legado (SM-016, texto puro) — substituído pelas 3 colunas *Ciphertext/
  // *Iv/*AuthTag (AES-256-GCM). Mantido só para o backfill; remoção em
  // migration futura (política: adicionar → backfill → remover em separado).
  pixKey           String?
  pixKeyCiphertext String?
  pixKeyIv         String?
  pixKeyAuthTag    String?
  pixKeyType       String?
  isAnonymous      Boolean      @default(false)
  showInWall       Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  audience Audience  @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([audienceId, status, created_at])
  @@index([musicianId, status, created_at])
  @@index([bandId, status, created_at])
  @@index([status, created_at])
  @@map("tips")
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String?
  musicianId    String?
  bandId        String?
  type          String // "tip", "booking_fee", "commission"
  amount        Decimal           @db.Decimal(12, 2)
  fee           Decimal           @default(0) @db.Decimal(12, 2)
  netAmount     Decimal           @db.Decimal(12, 2)
  currency      CurrencyEnum      @default(BRL)
  status        TransactionStatus @default(pending)
  paymentMethod String
  externalId    String?           @unique // ID do provedor de pagamento — UNIQUE impede lançar duas vezes o mesmo pagamento/transferência (NULLs não colidem no Postgres)
  /// Chave de idempotência do CLIENTE (header `Idempotency-Key`), distinta do
  /// `externalId`, que é do PROVEDOR e só existe depois da chamada.
  ///
  /// 🔴 É o que impede o duplo clique de virar dois saques. O lock da carteira
  /// serializa a corrida e o saldo barra o segundo débito quando não há fundo
  /// para os dois — mas com saldo suficiente os dois saques passariam, cada um
  /// legítimo isoladamente, e o músico veria sair o dobro do que pediu.
  /// UNIQUE porque a garantia tem de vir do banco: checar antes e inserir
  /// depois reabre exatamente a janela que este campo existe para fechar.
  /// Nullable — chamadores internos (job, webhook) não têm cliente para gerar
  /// chave, e NULLs não colidem no Postgres.
  idempotencyKey String?          @unique
  metadata      Json?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  audience Audience? @relation(fields: [userId], references: [id], onDelete: SetNull)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)
  band     Band?     @relation(fields: [bandId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([musicianId])
  @@index([bandId])
  @@map("transactions")
}

model MusicianWallet {
  id                       String       @id @default(uuid())
  musicianId               String       @unique
  balance                  Decimal      @default(0) @db.Decimal(12, 2)
  totalEarned              Decimal      @default(0) @db.Decimal(12, 2)
  totalWithdrawn           Decimal      @default(0) @db.Decimal(12, 2)
  currency                 CurrencyEnum @default(BRL)
  // Legado (SM-016, texto puro) — substituído pelas colunas *Ciphertext/*Iv/
  // *AuthTag (AES-256-GCM). Mantido só para o backfill; remoção em migration
  // futura (política: adicionar → backfill → remover em separado).
  pixKey                   String?
  pixKeyCiphertext         String?
  pixKeyIv                 String?
  pixKeyAuthTag            String?
  pixKeyType               String?
  bankAccount              Json? // Dados bancários — legado, ver acima
  bankAccountCiphertext    String?
  bankAccountIv            String?
  bankAccountAuthTag       String?
  /// Cachê sob custódia — recebido, ainda NÃO liberado. Fica fora de `balance`
  /// de propósito: dinheiro em custódia não é sacável, e somá-lo ao saldo faria
  /// o app prometer um saque que o gateway recusaria.
  heldBalance              Decimal      @default(0) @db.Decimal(12, 2)
  /// Subconta do músico na instituição de pagamento (F1.0). `walletId` do Asaas.
  asaasWalletId            String?      @unique
  /// 🔴 A `apiKey` da subconta só existe NO MOMENTO DA CRIAÇÃO e não pode ser
  /// recuperada depois. Cifrada em repouso (AES-256-GCM), mesma infra de SM-016
  /// que já protege chave PIX e conta bancária — nunca em coluna clara.
  asaasApiKeyCiphertext    String?
  asaasApiKeyIv            String?
  asaasApiKeyAuthTag       String?
  /// Status da subconta no provedor. String, não enum: é vocabulário DELE, e
  /// muda sem nos avisar (mesma regra dos status de worker).
  asaasAccountStatus       String?
  /// ─── Vínculo Mercado Pago (gorjeta) ───────────────────────────────────
  /// O MP é o gateway da GORJETA porque cobra 0,99% sem piso — a taxa fixa do
  /// Asaas (R$1,99) torna deficitária toda gorjeta abaixo de R$22. Aqui o
  /// músico usa a CONTA DELE, vinculada por OAuth: o dinheiro nunca passa pelo
  /// patrimônio da plataforma, mesma postura regulatória da subconta Asaas.
  mpUserId                 String?      @unique
  /// 🔴 Tokens OAuth cifrados em repouso (AES-256-GCM, infra de SM-016). O
  /// access_token move dinheiro na conta do músico.
  mpAccessTokenCiphertext  String?
  mpAccessTokenIv          String?
  mpAccessTokenAuthTag     String?
  /// Sem o refresh_token o vínculo morre em 180 dias e o músico precisa
  /// reautorizar na mão — por isso ele é tão sensível quanto o access.
  mpRefreshTokenCiphertext String?
  mpRefreshTokenIv         String?
  mpRefreshTokenAuthTag    String?
  /// Quando o access_token expira. O job de renovação varre por esta coluna.
  mpTokenExpiresAt         DateTime?
  /// Conta Escrow habilitada nesta subconta. Custa R$9,90/mês por subconta, e
  /// desabilitar LIBERA tudo que ainda está sob garantia — por isso o
  /// liga/desliga é decisão de domínio, não configuração global.
  escrowEnabled            Boolean      @default(false)
  is_active                Boolean      @default(true)
  created_at               DateTime     @default(now())
  updated_at               DateTime     @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@map("musician_wallets")
}

/// Custódia do cachê de um show (F1.3a).
///
/// O dinheiro **não transita pelo patrimônio da SoundMeet** — fica na subconta
/// do músico na instituição de pagamento, bloqueado. É o que a cláusula
/// `papel_da_plataforma.com_custodia` do contrato AFIRMA, e por isso o caminho
/// (i) "ledger interno com o dinheiro na conta da plataforma" foi recusado:
/// ligá-lo transformaria cláusula assinada em declaração falsa.
///
/// `bookingId @unique` é a barreira de idempotência: webhook reentregue ou
/// dupla confirmação não criam segunda custódia.
model BookingEscrow {
  id             String              @id @default(uuid())
  bookingId      String              @unique
  musicianId     String?
  /// Valor BRUTO recebido do estabelecimento.
  amount         Decimal             @db.Decimal(12, 2)
  /// Comissão da plataforma. 🔴 Só é devida NA LIBERAÇÃO — show não realizado,
  /// nenhuma comissão. É o argumento mais forte contra responsabilidade
  /// solidária, e está escrito na cláusula.
  platformFee    Decimal             @default(0) @db.Decimal(12, 2)
  /// O que o músico recebe (amount − platformFee).
  netAmount      Decimal             @db.Decimal(12, 2)
  currency       CurrencyEnum        @default(BRL)
  status         BookingEscrowStatus @default(pending)
  /// Id da cobrança/garantia no provedor. UNIQUE impede lançar duas vezes o
  /// mesmo pagamento (NULLs não colidem no Postgres) — mesmo padrão de
  /// `Transaction.externalId`.
  externalId     String?             @unique
  /// Quando a liberação automática do provedor vence (`daysToExpire`).
  /// Guardado porque o job precisa saber se ainda dá tempo de liberar antes.
  expiresAt      DateTime?
  heldAt         DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  /// Por que foi devolvido ou congelado. Obrigatório nas duas transições, para
  /// que um estorno nunca fique sem justificativa no histórico.
  resolutionNote String?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  musician Musician? @relation(fields: [musicianId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([musicianId])
  @@map("booking_escrows")
}

/// Ledger de idempotência de eventos externos (webhooks de gateway).
/// Fonte de verdade DURÁVEL: `eventKey` UNIQUE transforma "já processei este
/// evento?" numa decisão atômica do Postgres. Redis não serve aqui — reinício
/// ou evicção apagariam a marca e uma reentrega creditaria a gorjeta de novo.
/// `status` é operacional (não é máquina de estado de domínio) → String.
model ProcessedEvent {
  id           String    @id @default(uuid())
  eventKey     String    @unique
  scope        String
  status       String    @default("processing")
  attempts     Int       @default(0)
  last_error   String?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([scope, status])
  @@map("processed_events")
}

// ========================================
// DOMÍNIO AI AUDIO
// ========================================

model AiAudioUpload {
  id                  String   @id @default(uuid())
  musicianId          String
  /// Música da biblioteca que originou este áudio, quando o Modo Ensaio pediu
  /// a separação a partir do repertório. Espelha `AiCifraUpload.musicLibraryId`
  /// — é este elo que permite mostrar a cifra do ChordFormer ao lado dos stems.
  /// Null quando o músico subiu um arquivo solto.
  musicLibraryId      String?
  original_filename   String
  content_type        String
  file_size           Int
  object_key          String
  upload_method       String
  multipart_upload_id String?
  duration_seconds    Int?
  codec               String?
  sample_rate         Int?
  channels            Int?
  status              String
  rejected_reason     String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  musician     Musician               @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  musicLibrary MusicLibrary?          @relation(fields: [musicLibraryId], references: [id], onDelete: SetNull)
  jobs         AiAudioSeparationJob[]

  @@index([musicianId, status, created_at])
  @@index([musicLibraryId])
  @@map("ai_audio_uploads")
}

model AiAudioSeparationJob {
  id               String    @id @default(uuid())
  aiAudioUploadId  String
  musicianId       String
  model_id         String
  output_prefix    String
  output_format    String?
  status           String
  progress_percent Int       @default(0)
  progress_stage   String?
  error_code       String?
  error_message    String?
  started_at       DateTime?
  finished_at      DateTime?
  /// 🔴 Quando os stems desta separação devem ser APAGADOS do storage.
  ///
  /// O ai-cifra nunca retém a gravação: apaga o objeto no instante em que a
  /// análise conclui, guardando só o dado derivado (a cifra). Stem não é dado
  /// derivado no mesmo sentido — stem É a gravação, separada. Reter os quatro
  /// por tempo indeterminado seria uma postura de direito autoral diferente da
  /// que o resto do projeto escolheu, então a retenção aqui é curta e
  /// explícita, varrida por `PurgeExpiredAiAudioStemsUseCase`.
  ///
  /// Null enquanto o job não concluiu — não há o que expirar.
  stems_expire_at  DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  upload   AiAudioUpload             @relation(fields: [aiAudioUploadId], references: [id], onDelete: Cascade)
  musician Musician                  @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  outputs  AiAudioSeparationOutput[]

  @@index([musicianId, status, created_at])
  /// A varredura de expiração busca exatamente por isto; sem índice seria
  /// sequential scan de hora em hora na tabela de jobs.
  @@index([status, stems_expire_at])
  @@map("ai_audio_separation_jobs")
}

model AiAudioSeparationOutput {
  id           String   @id @default(uuid())
  jobId        String
  stem_name    String
  object_key   String
  content_type String
  file_size    Int?
  created_at   DateTime @default(now())

  job AiAudioSeparationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ai_audio_separation_outputs")
}

// ========================================
// DOMÍNIO AI CIFRA
// ========================================

model AiCifraUpload {
  id                String   @id @default(uuid())
  musicianId        String
  musicLibraryId    String?
  original_filename String
  content_type      String
  file_size         Int
  object_key        String
  upload_method     String
  status            String
  rejected_reason   String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  musician     Musician             @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  musicLibrary MusicLibrary?        @relation(fields: [musicLibraryId], references: [id], onDelete: SetNull)
  jobs         AiCifraAnalysisJob[]

  @@index([musicianId, status, created_at])
  @@index([musicLibraryId])
  @@map("ai_cifra_uploads")
}

model AiCifraAnalysisJob {
  id               String    @id @default(uuid())
  aiCifraUploadId  String
  musicianId       String
  model_id         String
  status           String
  progress_percent Int       @default(0)
  progress_stage   String?
  error_code       String?
  error_message    String?
  started_at       DateTime?
  finished_at      DateTime?
  bpm              Int?
  key              String?
  time_signature   String?
  chords           Json?
  segments         Json?
  artifacts        Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  upload   AiCifraUpload @relation(fields: [aiCifraUploadId], references: [id], onDelete: Cascade)
  musician Musician      @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, status, created_at])
  @@map("ai_cifra_analysis_jobs")
}

model SyncedLyricsBulkJob {
  id            String    @id @default(uuid())
  musicianId    String
  status        String
  total         Int       @default(0)
  processed     Int       @default(0)
  success       Int       @default(0)
  failed        Int       @default(0)
  error_summary Json?
  started_at    DateTime?
  finished_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([musicianId, status, created_at])
  @@map("synced_lyrics_bulk_jobs")
