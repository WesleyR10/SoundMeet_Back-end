NODE_ENV=test
PORT=3001

# Database URLs
DATABASE_URL="postgresql://test:test@localhost:5432/soundmeet_test"
MONGODB_URL="mongodb://localhost:27017/soundmeet_test"
REDIS_URL="redis://localhost:6379"

# RabbitMQ
RABBITMQ_URL="amqp://localhost:5672"
RABBITMQ_EXCHANGE="soundmeet_test"
RABBITMQ_QUEUE_REQUESTS="requests_test"
RABBITMQ_QUEUE_NOTIFICATIONS="notifications_test"
RABBITMQ_QUEUE_PAYMENTS="payments_test"
RABBITMQ_QUEUE_GAMIFICATION="gamification_test"

# Keycloak
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="soundmeet-test"
KEYCLOAK_CLIENT_ID="soundmeet-test-client"
KEYCLOAK_CLIENT_SECRET="test-client-secret"

# JWT
JWT_SECRET="test-jwt-secret-key-for-e2e-tests"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="test-jwt-refresh-secret-key-for-e2e-tests"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3
AWS_REGION="us-east-1"
AWS_S3_BUCKET="soundmeet-test-bucket"

# MinIO (Development)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="soundmeet-test"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,gif,webp"
ALLOWED_VIDEO_TYPES="mp4,webm,mov"
ALLOWED_AUDIO_TYPES="mp3,wav,ogg,m4a"

# Gamification
POINTS_SCAN_QR=10
POINTS_MUSIC_REQUEST=25
POINTS_REQUEST_ACCEPTED=50
POINTS_TIP_MULTIPLIER=1
POINTS_SOCIAL_SHARE=50

# Business Rules
MAX_REQUESTS_PER_USER_PER_EVENT=5
REQUEST_COOLDOWN_MINUTES=2
VOTING_INTERVAL_MINUTES=3