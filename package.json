{
  "name": "soundmeet-backend",
  "version": "1.0.0",
  "description": "Backend da plataforma SoundMeet - Conexão Musical",
  "author": "SoundMeet Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run prisma:prepare && nest build --builder tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "docker:up": "DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 docker compose up -d --build",
    "docker:down": "docker compose down --remove-orphans",
    "docker:ps": "docker compose ps -a",
    "docker:bootstrap": "sh -lc 'set -a; . ./envs/.env; set +a; npm run docker:up && docker exec soundmeet-postgres sh -lc \"until pg_isready -U ${POSTGRES_USER:-soundmeet} -d ${POSTGRES_DB:-soundmeet} >/dev/null 2>&1; do sleep 1; done\" && GW=$(ip route | awk \"/default/ {print \\$3; exit}\") && DATABASE_URL=${DATABASE_URL/localhost:5432/${GW:-localhost}:5432} npx prisma db push'",
    "docker:logs:app": "docker logs --tail=200 -f soundmeet-app",
    "docker:restart:app": "docker restart soundmeet-app",
    "start": "nest start",
    "start:dev": "nest start --watch --builder tsc -p tsconfig.dev.json",
    "start:debug": "nest start --debug --watch --builder tsc -p tsconfig.dev.json",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migrate:ts": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./src/migrate.ts",
    "migrate:js": "node ./dist/migrate.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.ts",
    "test:e2e:watch": "jest --config ./test/jest-e2e.config.ts --watch",
    "rabbitmq:consumers:dev": "npm run start:dev -- --entryFile cmd/rabbitmq",
    "rabbitmq:consumers:prod": "node dist/cmd/rabbitmq",
    "prisma:generate": "prisma generate",
    "prisma:prepare": "prisma generate && node -e \"const fs=require('fs'); const path=require('path'); const link=path.resolve('node_modules/@prisma/client/.prisma'); const target=path.resolve('node_modules/.prisma'); try{ if(!fs.existsSync(link)){ fs.symlinkSync(target, link, 'dir'); } } catch(e){ process.exit(0); }\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^4.1.0",
    "@nestjs/cache-manager": "^2.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^3.0.0",
    "@nestjs/swagger": "^7.1.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@prisma/sqlcommenter-query-tags": "^7.0.1",
    "@prisma/sqlcommenter-trace-context": "^7.0.1",
    "aws-sdk": "^2.1400.0",
    "axios": "^1.5.0",
    "bcrypt": "^5.1.0",
    "cache-manager": "^5.2.0",
    "cache-manager-redis-store": "^3.0.1",
    "chance": "^1.1.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron": "^2.4.0",
    "dotenv": "^16.3.1",
    "firebase-admin": "^13.5.0",
    "joi": "^17.13.3",
    "keycloak-connect": "^22.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "nest-keycloak-connect": "^1.9.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jest/environment": "^30.1.2",
    "@jest/fake-timers": "^30.1.2",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.84",
    "@swc/jest": "^0.2.29",
    "@types/bcrypt": "^5.0.0",
    "@types/chance": "^1.1.7",
    "@types/cron": "^2.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/lodash": "^4.14.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chokidar": "^3.6.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^29.5.0",
    "jest-mock": "^30.0.5",
    "prettier": "^3.0.0",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
