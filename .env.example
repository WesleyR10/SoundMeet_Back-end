# Variáveis lidas pelo próprio `docker compose` (substituição ${VAR} dentro de
# docker-compose.yml) — NÃO confundir com envs/.env, que é o env_file injetado
# dentro do container "app". Copie para ".env" nesta mesma pasta (raiz do
# soundmeet-backend, ao lado do docker-compose.yml) se quiser sobrescrever os
# defaults de dev abaixo.

# Senha do admin do Keycloak e do postgres-keycloak (SM-014). Servem só para o
# serviço "keycloak" do docker-compose.yml, que é DEV-ONLY (start-dev, HTTP
# sem TLS) — nunca promover para produção sem revisão. Produção usa secret
# manager/env externo dedicado (ver infra/keycloak/docker-compose.prod.yml).
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_DB_PASSWORD=soundmeet123

# E-mail transacional (Resend) usado pelo realm-soundmeet.json no import do
# Keycloak. Vazio funciona em dev (Keycloak só não envia e-mail).
RESEND_API_KEY=
MAIL_FROM=noreply@soundmeet.com.br
